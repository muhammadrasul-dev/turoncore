---
import { languages, type Lang, type Translations } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import ContactModal from '../components/ContactModal.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  t: Translations;
  title?: string;
  description?: string;
}

const { lang, t, title, description } = Astro.props;
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl);
const defaultLocaleUrl = new URL('/uz/', siteUrl).toString();
const alternateUrls = languages.map(({ code }) => ({
  code,
  hrefLang: code === 'uz' ? 'uz-UZ' : code === 'ru' ? 'ru-RU' : 'en',
  href: new URL(`/${code}/`, siteUrl).toString(),
}));
const ogImage = new URL('/logos/logo-light-bg.png', siteUrl).toString();
const telegramUrl = `https://t.me/${t.footer.telegram.replace('@', '')}`;
const instagramUrl = `https://instagram.com/${t.contact.placeholders.instagram.replace('@', '')}`;
const phone = t.contact.placeholders.phone.replace(/\s/g, '');
const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'TuronCore',
      alternateName: ['Turon Core', 'turoncore', 'turon core'],
      url: siteUrl.toString(),
      logo: ogImage,
      image: ogImage,
      description: pageDescription,
      email: t.contact.placeholders.email,
      telephone: t.contact.placeholders.phone,
      address: {
        '@type': 'PostalAddress',
        addressLocality: t.meta.city,
        addressCountry: t.meta.country,
      },
      areaServed: t.meta.areaServed,
      sameAs: [telegramUrl, instagramUrl, 'https://youtube.com/@turoncore'],
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: phone,
        contactType: 'sales',
        areaServed: t.meta.areaServed,
        availableLanguage: ['uz', 'ru', 'en'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl.toString(),
      name: 'TuronCore',
      inLanguage: lang,
      publisher: {
        '@id': `${siteUrl}#organization`,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.toString()}#webpage`,
      url: canonical.toString(),
      name: pageTitle,
      description: pageDescription,
      isPartOf: {
        '@id': `${siteUrl}#website`,
      },
      about: {
        '@id': `${siteUrl}#organization`,
      },
      inLanguage: lang,
    },
    {
      '@type': 'Service',
      '@id': `${siteUrl}#what-we-do`,
      name: t.meta.serviceName,
      provider: {
        '@id': `${siteUrl}#organization`,
      },
      areaServed: t.meta.areaServed,
      serviceType: t.meta.serviceTypes,
      description: t.whatWeDo.subtitle,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.whatWeDo.title,
        itemListElement: t.meta.serviceTypes.map((service: string) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: service,
          },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={t.meta.keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="TuronCore" />
    <meta name="application-name" content="TuronCore" />
    <meta name="theme-color" content="#f3f5f7" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical.toString()} />
    {alternateUrls.map(({ hrefLang, href }) => <link rel="alternate" hreflang={hrefLang} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <noscript>
      <style>
        .reveal, .reveal-scale {
          opacity: 1 !important;
          transform: none !important;
        }
        #page-preloader {
          display: none !important;
        }
      </style>
    </noscript>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TuronCore" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t.meta.imageAlt} />
    <meta property="og:locale" content={lang === 'uz' ? 'uz_UZ' : lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <script is:inline>
      (function () {
        try {
          document.documentElement.classList.remove('dark');
          localStorage.removeItem('theme');
          if (sessionStorage.getItem('tc-ready') === '1') {
            document.documentElement.classList.add('app-ready');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <!-- Premium Layout Preloader Overlay -->
    <div
      id="page-preloader"
      class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-bg transition-all duration-[800ms] cubic-bezier(0.16, 1, 0.3, 1)"
    >
      <div class="relative flex flex-col items-center">
        <div class="relative h-14 w-14">
          <div class="absolute inset-0 rounded-full border-t-2 border-r-2 border-accent animate-spin"></div>
          <div class="absolute inset-2 rounded-full border-b-2 border-l-2 border-accent-bright animate-spin" style="animation-direction: reverse; animation-duration: 0.8s"></div>
        </div>
        <div class="mt-6 font-display text-[0.85rem] font-bold uppercase tracking-[0.2em] text-muted">
          Turon<span class="text-ink">Core</span>
        </div>
      </div>
    </div>

    <!-- Preloader controller script -->
    <script is:inline>
      (function () {
        if (document.documentElement.classList.contains('app-ready')) {
          const preloader = document.getElementById('page-preloader');
          if (preloader) preloader.remove();
          return;
        }

        document.documentElement.classList.add('lenis-stopped');

        window.addEventListener('load', function () {
          const preloader = document.getElementById('page-preloader');
          try {
            sessionStorage.setItem('tc-ready', '1');
            document.documentElement.classList.add('app-ready');
          } catch (e) {}
          if (preloader) {
            preloader.style.opacity = '0';
            preloader.style.visibility = 'hidden';
            preloader.style.transform = 'translateY(-24px)';

            setTimeout(function () {
              preloader.remove();
              document.documentElement.classList.remove('lenis-stopped');
              
              const heroReveals = document.querySelectorAll('#hero .reveal, #hero .reveal-scale');
              heroReveals.forEach(function (el) {
                el.classList.add('visible');
              });
            }, 850);
          }
        });
      })();
    </script>

    <div id="scroll-progress"></div>

    <a
      href="#main"
      class="btn btn-primary sr-only px-5 py-2.5 text-sm focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100]"
    >
      Skip to content
    </a>

    <Header lang={lang} t={t} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} t={t} />

    <FloatingContact lang={lang} t={t} />

    <ContactModal lang={lang} t={t} />

    <script>
      import { bindPage } from '../scripts/page.ts';
      import { initLangSwitchers } from '../scripts/lang.ts';
      import { initSmoothScroll } from '../scripts/scroll.ts';

      bindPage();
      initLangSwitchers();
      initSmoothScroll();
    </script>
  </body>
</html>
