---
import { getLocalizedPath, languages, type Lang, type Translations } from '../i18n/ui';
import { hrefLangMap, ogLocaleMap } from '../lib/routes';
import { breadcrumbSchema, type BreadcrumbItem } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import ContactModal from '../components/ContactModal.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  t: Translations;
  title?: string;
  description?: string;
  path?: string;
  ogImagePath?: string;
  robots?: string;
  breadcrumbs?: BreadcrumbItem[];
  extraSchema?: Record<string, unknown>[];
}

const {
  lang,
  t,
  title,
  description,
  path,
  ogImagePath = '/og.png',
  robots = 'index, follow, max-image-preview:large',
  breadcrumbs = [],
  extraSchema = [],
} = Astro.props;

const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const contentPath = path ?? Astro.url.pathname;
const canonical = new URL(getLocalizedPath(contentPath, lang), siteUrl);
const defaultLocaleUrl = new URL(getLocalizedPath(contentPath, 'uz'), siteUrl).toString();
const alternateUrls = languages.map(({ code }) => ({
  code,
  hrefLang: hrefLangMap[code],
  href: new URL(getLocalizedPath(contentPath, code), siteUrl).toString(),
}));
const ogImage = new URL(ogImagePath, siteUrl).toString();
const logoImage = new URL('/logos/logo-light-bg.png', siteUrl).toString();
const telegramUrl = `https://t.me/${t.footer.telegram.replace('@', '')}`;
const instagramUrl = `https://instagram.com/${t.contact.placeholders.instagram.replace('@', '')}`;
const phone = t.contact.placeholders.phone.replace(/\s/g, '');
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
const yandex = import.meta.env.PUBLIC_YANDEX_VERIFICATION;
const orgId = `${siteUrl.toString().replace(/\/$/, '')}#organization`;
const siteId = `${siteUrl.toString().replace(/\/$/, '')}#website`;

const graph: Record<string, unknown>[] = [
  {
    '@type': ['Organization', 'ProfessionalService'],
    '@id': orgId,
    name: 'TuronCore',
    alternateName: ['Turon Core', 'turoncore', 'turon core'],
    url: siteUrl.toString(),
    logo: logoImage,
    image: ogImage,
    description: t.meta.description,
    email: t.contact.placeholders.email,
    telephone: phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: t.meta.city,
      addressCountry: t.meta.country,
    },
    areaServed: t.meta.areaServed,
    sameAs: [telegramUrl, instagramUrl, 'https://youtube.com/@turoncore'],
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: phone,
      contactType: 'sales',
      areaServed: t.meta.areaServed,
      availableLanguage: ['uz', 'ru', 'en'],
    },
  },
  {
    '@type': 'WebSite',
    '@id': siteId,
    url: siteUrl.toString(),
    name: 'TuronCore',
    inLanguage: lang,
    publisher: { '@id': orgId },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical.toString()}#webpage`,
    url: canonical.toString(),
    name: pageTitle,
    description: pageDescription,
    isPartOf: { '@id': siteId },
    about: { '@id': orgId },
    inLanguage: lang,
  },
];

if (breadcrumbs.length) {
  graph.push(breadcrumbSchema(breadcrumbs));
}

graph.push(...extraSchema);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robots} />
    <meta name="author" content="TuronCore" />
    <meta name="application-name" content="TuronCore" />
    <meta name="theme-color" content="#f3f5f7" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    {yandex && <meta name="yandex-verification" content={yandex} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical.toString()} />
    {alternateUrls.map(({ hrefLang, href }) => <link rel="alternate" hreflang={hrefLang} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <noscript>
      <style>
        .reveal, .reveal-scale {
          opacity: 1 !important;
          transform: none !important;
        }
        #page-preloader {
          display: none !important;
        }
      </style>
    </noscript>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TuronCore" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.imageAlt} />
    <meta property="og:locale" content={ogLocaleMap[lang]} />
    {
      languages
        .filter(({ code }) => code !== lang)
        .map(({ code }) => <meta property="og:locale:alternate" content={ogLocaleMap[code]} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        try {
          document.documentElement.classList.remove('dark');
          localStorage.removeItem('theme');
          document.documentElement.classList.add('app-ready');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <div id="scroll-progress"></div>

    <a
      href="#main"
      class="btn btn-primary sr-only px-5 py-2.5 text-sm focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100]"
    >
      Skip to content
    </a>

    <Header lang={lang} t={t} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} t={t} />

    <FloatingContact lang={lang} t={t} />

    <ContactModal lang={lang} t={t} />

    <script>
      import { bindPage } from '../scripts/page.ts';
      import { initLangSwitchers } from '../scripts/lang.ts';
      import { initSmoothScroll } from '../scripts/scroll.ts';
      import { inject } from '@vercel/analytics';

      initSmoothScroll();
      bindPage();
      initLangSwitchers();
      inject();
    </script>
  </body>
</html>
