---
import type { Lang, Translations } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  t: Translations;
  title?: string;
  description?: string;
}

const { lang, t, title, description } = Astro.props;
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const isDark = saved ? saved === 'dark' : true;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <Header lang={lang} t={t} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} t={t} />

    <script>
      import '../scripts/theme.ts';
      import '../scripts/reveal.ts';
      import '../scripts/header.ts';
    </script>
  </body>
</html>
