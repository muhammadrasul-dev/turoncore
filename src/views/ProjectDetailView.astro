---
import type { Lang, Translations } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCover from '../components/ProjectCover.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props {
  lang: Lang;
  t: Translations;
  project: CollectionEntry<'portfolio'>;
  index?: number;
}

const { lang, t, project, index = 0 } = Astro.props;
const { Content } = await render(project);
const home = getLocalizedPath('/', lang);
const projectsPath = getLocalizedPath('/projects', lang);
const servicePath = getLocalizedPath(`/services/${project.data.relatedService}`, lang);
---

<section class="section relative overflow-hidden pt-32 md:pt-36">
  <div class="shell max-w-3xl">
    <Breadcrumbs
      items={[
        { name: t.common.home, href: home },
        { name: t.pages.projectsTitle, href: projectsPath },
        { name: project.data.title },
      ]}
    />
    <div class="mt-8">
      <PageHero title={project.data.title} lead={project.data.description} />
    </div>

    {
      project.data.screenshots.length > 0 ? (
        <div class="shots mt-8" aria-label={t.common.screenshots} role="group">
          {project.data.screenshots.map((src, i) => (
            <img
              src={src}
              alt={`${project.data.imageAlt} — ${i + 1}`}
              width="690"
              height="1496"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))}
        </div>
      ) : (
        <div class="reveal mt-8 overflow-hidden rounded-[var(--r-lg)]">
          <ProjectCover title={project.data.title} highlight={project.data.highlight} index={index} />
        </div>
      )
    }

    <div class="mt-6 flex flex-wrap items-center gap-3">
      {project.data.icon && (
        <img src={project.data.icon} alt="" width="40" height="40" class="h-10 w-10 rounded-[0.7rem] shadow-[0_0_0_1px_var(--c-hairline)]" />
      )}
      <p class="mr-auto text-sm font-semibold text-faint">{project.data.platform}</p>
      {project.data.appStore && (
        <a href={project.data.appStore} target="_blank" rel="noopener noreferrer" class="btn btn-soft px-4 py-2 text-sm">
          {t.common.appStore}
        </a>
      )}
      {project.data.playStore && (
        <a href={project.data.playStore} target="_blank" rel="noopener noreferrer" class="btn btn-soft px-4 py-2 text-sm">
          {t.common.playStore}
        </a>
      )}
    </div>

    <div class="prose-content reveal mt-8 space-y-4 text-[0.98rem] leading-relaxed text-muted">
      <Content />
    </div>

    <div class="reveal mt-10 space-y-8">
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink">{t.common.challenge}</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{project.data.challenge}</p>
      </div>
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink">{t.common.solution}</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{project.data.solution}</p>
      </div>
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink">{t.common.features}</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
          {project.data.features.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink">{t.common.result}</h2>
        <dl class="mt-4 grid grid-cols-2 gap-3">
          {project.data.metrics.map((metric) => (
            <div class="surface border border-hairline/30 p-4">
              <dt class="text-xs uppercase tracking-wider text-faint">{metric.label}</dt>
              <dd class="mt-1 font-display text-xl font-extrabold text-ink">{metric.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink">{t.common.stack}</h2>
        <p class="mt-3 text-sm text-muted">{project.data.stack.join(', ')}</p>
      </div>
    </div>

    <p class="reveal mt-8 text-sm">
      <a href={servicePath} class="font-semibold text-accent">{t.nav.services}</a>
    </p>

    <CtaBand lang={lang} title={t.footer.contactText} cta={t.common.discuss} />
  </div>
</section>

<style>
  .shots {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(10rem, 1fr);
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }

  .shots img {
    width: 100%;
    height: auto;
    aspect-ratio: 690 / 1496;
    object-fit: cover;
    border-radius: 1.2rem;
    scroll-snap-align: start;
    box-shadow: 0 0 0 1px var(--c-hairline);
  }

  .prose-content :global(h2) {
    margin-top: 1.5rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--c-text);
  }
  .prose-content :global(p) {
    margin: 0.6rem 0;
  }
</style>
