---
import type { Lang, Translations } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/ui';
import { getProjects } from '../lib/content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCover from '../components/ProjectCover.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
const projects = await getProjects(lang);
const home = getLocalizedPath('/', lang);
---

<section class="section relative isolate overflow-hidden pt-32 md:pt-36">
  <div class="shell">
    <Breadcrumbs
      items={[
        { name: t.common.home, href: home },
        { name: t.pages.projectsTitle },
      ]}
    />
    <div class="mt-8">
      <PageHero title={t.pages.projectsTitle} lead={t.pages.projectsLead} />
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => {
          const shot = project.data.screenshots[0];
          const icons = project.data.apps.length > 1 ? project.data.apps.map((a) => a.icon) : project.data.icon ? [project.data.icon] : [];
          return (
            <a href={getLocalizedPath(`/projects/${project.data.pageSlug}`, lang)} class="project-card group">
              <div class="project-media">
                {shot ? (
                  <img src={shot} alt={project.data.imageAlt} width="690" height="1496" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                ) : (
                  <ProjectCover title={project.data.title} highlight={project.data.highlight} index={i} />
                )}
              </div>
              <div class="flex items-start gap-3 p-5">
                {icons.length > 0 && (
                  <span class="flex shrink-0">
                    {icons.map((src, k) => (
                      <img src={src} alt="" width="40" height="40" class:list={['project-icon', k > 0 && '-ml-3']} loading="lazy" />
                    ))}
                  </span>
                )}
                <div class="min-w-0">
                  <h2 class="text-lg font-semibold text-ink">{project.data.title}</h2>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{project.data.description}</p>
                  <span class="mt-3 inline-block text-xs font-semibold text-accent-deep">{project.data.highlight}</span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <CtaBand lang={lang} title={t.footer.contactText} cta={t.common.discuss} />
  </div>
</section>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: #fff;
    box-shadow: 0 0 0 1px var(--c-hairline);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .project-card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 0 0 1px var(--c-hairline),
      var(--shadow-md);
  }

  .project-media {
    display: flex;
    justify-content: center;
    height: 15rem;
    padding: 1.25rem 1.25rem 0;
    overflow: hidden;
    background: var(--c-bg-soft);
  }

  .project-media img {
    width: 55%;
    max-width: 11rem;
    height: auto;
    align-self: flex-start;
    border-radius: 1.1rem 1.1rem 0 0;
    box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.45);
    transition: transform 0.35s var(--ease);
  }

  .project-media :global(> div) {
    width: 100%;
    align-self: center;
  }

  .project-card:hover .project-media img {
    transform: translateY(-6px);
  }

  .project-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.7rem;
    background: #fff;
    box-shadow: 0 0 0 1px var(--c-hairline);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card:hover,
    .project-card:hover .project-media img {
      transition: none;
      transform: none;
    }
  }
</style>
