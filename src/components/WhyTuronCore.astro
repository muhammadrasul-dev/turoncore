---
import type { Translations } from '../i18n/ui';
import GeometricBg from './GeometricBg.astro';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section id="why" class="section band feather-top feather-bottom relative overflow-hidden">
  <GeometricBg grid={false} intensity="soft" />

  <div class="shell relative">
    <SectionHeading
      eyebrow={t.why.eyebrow}
      title={t.why.title}
      subtitle={t.why.subtitle}
      class="mb-12 md:mb-16"
    />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.why.items.map((item, i) => (
          <article
            class="group surface spot js-spot lift reveal relative overflow-hidden p-6 md:p-8 border border-hairline/30 hover:border-accent/30 transition-all duration-500 hover:shadow-2xl hover:shadow-accent/5"
            style={`--rd:${i * 80}ms`}
          >
            <span
              class="absolute left-0 top-6 bottom-6 w-[3px] rounded-full bg-linear-to-b from-accent to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100"
              aria-hidden="true"
            />
            <div class="relative z-10">
              <span class="text-xs font-semibold text-accent/50 group-hover:text-accent transition-colors duration-500 font-display">
                {item.num}
              </span>
              <h3 class="text-lg font-bold text-ink group-hover:text-accent transition-colors duration-300 mt-4">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">
                {item.desc}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
