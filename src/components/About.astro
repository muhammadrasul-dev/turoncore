---
import type { Translations } from '../i18n/ui';
import SectionHeading from './ui/SectionHeading.astro';
import Card from './ui/Card.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const stats = [
  { value: '20+', label: t.about.stats.projects },
  { value: '15+', label: t.about.stats.clients },
  { value: '3+', label: t.about.stats.years },
  { value: '10+', label: t.about.stats.team },
];
---

<section id="about" class="py-20 md:py-28 bg-navy/[0.02] dark:bg-white/[0.02]">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="reveal">
      <SectionHeading title={t.about.title} subtitle={t.about.subtitle} />
    </div>

    <div class="grid gap-6 md:grid-cols-2 mb-16">
      <div class="reveal reveal-delay-1">
        <Card>
          <h3 class="text-lg font-semibold text-emerald mb-3">{t.about.mission.title}</h3>
          <p class="text-navy/60 dark:text-white/60 leading-relaxed">{t.about.mission.text}</p>
        </Card>
      </div>
      <div class="reveal reveal-delay-2">
        <Card>
          <h3 class="text-lg font-semibold text-emerald mb-3">{t.about.vision.title}</h3>
          <p class="text-navy/60 dark:text-white/60 leading-relaxed">{t.about.vision.text}</p>
        </Card>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {
        stats.map((stat, i) => (
          <div class:list={['reveal text-center', `reveal-delay-${i + 1}`]}>
            <div class="text-3xl md:text-4xl font-bold text-emerald">{stat.value}</div>
            <div class="mt-1 text-sm text-navy/60 dark:text-white/60">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
