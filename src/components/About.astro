---
import type { Translations } from '../i18n/ui';
import GeometricBg from './GeometricBg.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const stats = [
  { value: 5, suffix: '+', label: t.about.stats.projects },
  { value: 7, suffix: '+', label: t.about.stats.clients },
  { value: 2, suffix: '+', label: t.about.stats.years },
  { value: 3, suffix: '+', label: t.about.stats.team },
];

const pillars = [t.about.mission];
---

<section id="about" class="section band feather-top feather-bottom relative overflow-hidden">
  <GeometricBg grid={false} intensity="soft" />

  <div class="shell relative">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div>
        <span class="eyebrow reveal">{t.about.eyebrow}</span>
        <h2 class="headline reveal mt-5 text-ink" style="--rd:70ms">{t.about.title}</h2>
        <p class="lede reveal mt-5" style="--rd:140ms">{t.about.subtitle}</p>

        <div class="mt-12 grid grid-cols-2 gap-x-8 gap-y-10">
          {
            stats.map((stat, i) => (
              <div class="reveal" style={`--rd:${200 + i * 80}ms`}>
                <div class="flex items-baseline">
                  <span
                    class="tabular accent-text font-display text-5xl font-extrabold md:text-6xl"
                    data-counter={stat.value}
                    data-duration="1800"
                  >
                    0
                  </span>
                  <span class="accent-text font-display text-3xl font-extrabold md:text-4xl">
                    {stat.suffix}
                  </span>
                </div>
                <p class="mt-2 text-sm text-faint">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-5 justify-center">
        {
          pillars.map((pillar, i) => (
            <article
              class="group surface spot js-spot lift reveal relative overflow-hidden p-8 md:p-10"
              style={`--rd:${i * 120}ms`}
            >
              <span
                class="absolute left-0 top-8 bottom-8 w-[3px] rounded-full bg-linear-to-b from-accent to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100"
                aria-hidden="true"
              />
              <div class="relative z-10">
                <h3 class="text-xl font-bold text-ink md:text-2xl">{pillar.title}</h3>
                <p class="mt-4 leading-relaxed text-muted">{pillar.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

