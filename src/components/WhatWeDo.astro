---
import type { Translations } from '../i18n/ui';
import SectionHeading from './ui/SectionHeading.astro';
import GeometricBg from './GeometricBg.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section id="what-we-do" class="section relative overflow-hidden">
  <GeometricBg grid={true} intensity="soft" />

  <div class="shell relative z-10">
    <SectionHeading
      eyebrow={t.whatWeDo.eyebrow}
      title={t.whatWeDo.title}
      subtitle={t.whatWeDo.subtitle}
      class="mb-12 md:mb-16"
    />

    <div class="grid gap-6 md:grid-cols-3 md:gap-8">
      {
        t.whatWeDo.items.map((item, i) => (
          <article
            class="group surface spot js-spot lift reveal relative flex flex-col overflow-hidden p-8 md:p-9 border border-hairline/30 hover:border-accent/30 transition-all duration-500 hover:shadow-2xl hover:shadow-accent/5"
            style={`--rd:${i * 90}ms`}
          >
            <span
              class="pointer-events-none absolute inset-x-8 top-0 h-px origin-left scale-x-0 bg-linear-to-r from-accent to-transparent transition-transform duration-700 group-hover:scale-x-100"
              aria-hidden="true"
            />

            <span class="inline-flex w-fit rounded-full bg-accent-soft px-3 py-1 text-[0.65rem] font-bold tracking-[0.2em] text-accent">
              {item.label}
            </span>

            <h3 class="relative z-10 mt-6 text-[1.35rem] font-bold text-ink group-hover:text-accent transition-colors duration-300">
              {item.title}
            </h3>

            <p class="relative z-10 mt-3 flex-1 text-[0.95rem] leading-relaxed text-muted">
              {item.description}
            </p>

            <a
              href={item.href}
              class="relative z-10 mt-8 inline-flex items-center gap-2 text-sm font-semibold text-accent group-hover:text-accent-bright transition-colors duration-300"
            >
              {item.cta}
              <svg
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h13M13 6l6 6-6 6" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
