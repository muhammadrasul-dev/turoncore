---
import type { Lang } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  cta: string;
}

const { lang, title, cta } = Astro.props;
const href = getLocalizedPath('/contact', lang);
---

<div class="relative isolate mt-14 overflow-hidden rounded-[var(--r-xl)] bg-bg-soft p-7 md:flex md:items-center md:justify-between md:gap-8 md:p-10">
  <span class="blob blob-green -z-10" style="width:28rem;aspect-ratio:1;right:-8rem;top:-14rem" aria-hidden="true"></span>
  <p class="max-w-xl font-display text-xl font-semibold leading-snug tracking-tight text-ink md:text-2xl">{title}</p>
  <a href={href} class="btn btn-primary mt-5 shrink-0 px-6 py-3 text-[0.95rem] md:mt-0">
    {cta}
  </a>
</div>
