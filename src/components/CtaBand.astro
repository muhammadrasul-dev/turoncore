---
import type { Lang } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  cta: string;
}

const { lang, title, cta } = Astro.props;
const href = getLocalizedPath('/contact', lang);
---

<div class="reveal mt-12 rounded-3xl border border-hairline/40 bg-accent-soft/40 p-6 md:flex md:items-center md:justify-between md:gap-6 md:p-8">
  <p class="max-w-xl text-base font-semibold text-ink">{title}</p>
  <a href={href} class="btn btn-primary mt-4 shrink-0 px-5 py-2.5 text-sm md:mt-0">
    {cta}
  </a>
</div>
