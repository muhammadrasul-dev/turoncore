---
import type { Lang } from '../i18n/ui';
import { languages, getLocalizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="flex items-center gap-1 rounded-lg border border-navy/10 dark:border-white/10 p-1">
  {
    languages.map(({ code, label }) => {
      const href = getLocalizedPath(currentPath, code);
      const isActive = lang === code;
      return (
        <a
          href={href}
          class:list={[
            'px-2.5 py-1 text-xs font-semibold rounded-md transition-colors duration-200',
            isActive
              ? 'bg-emerald text-white'
              : 'text-navy/60 dark:text-white/60 hover:text-emerald',
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          {label}
        </a>
      );
    })
  }
</div>
