---
import type { Lang } from '../i18n/ui';
import { languages, getLocalizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;

const languageIcons: Record<Lang, string> = {
  uz: '🇺🇿',
  ru: '🇷🇺',
  en: '🇬🇧',
};

const languageNames: Record<Lang, string> = {
  uz: 'O\'zbek',
  ru: 'Русский',
  en: 'English',
};
---

<div class="relative" data-lang-dropdown>
  <button
    type="button"
    class="flex items-center gap-2 rounded-full bg-inset px-3 py-2 text-sm font-medium text-ink transition-all duration-300 hover:bg-accent-soft hover:text-accent"
    aria-label="Select language"
    aria-expanded="false"
    data-lang-trigger
  >
    <span class="text-lg leading-none">{languageIcons[lang]}</span>
    <span class="hidden sm:inline">{lang.toUpperCase()}</span>
    <svg
      class="h-4 w-4 transition-transform duration-300"
      data-lang-chevron
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>

  <div
    class="absolute right-0 top-full z-50 mt-2 w-48 origin-top-right scale-95 opacity-0 pointer-events-none rounded-2xl bg-surface p-2 shadow-2xl border border-hairline/30 backdrop-blur-xl transition-all duration-300"
    data-lang-menu
  >
    {
      languages.map(({ code }) => {
        const href = getLocalizedPath(currentPath, code);
        const isActive = lang === code;
        return (
          <a
            href={href}
            data-lang-switch
            class:list={[
              'flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-medium transition-all duration-300',
              isActive
                ? 'bg-accent text-white shadow-lg shadow-accent/20'
                : 'text-muted hover:bg-accent-soft hover:text-accent',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="text-xl leading-none">{languageIcons[code]}</span>
            <span class="flex-1">{languageNames[code]}</span>
            {isActive && (
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
            )}
          </a>
        );
      })
    }
  </div>
</div>
