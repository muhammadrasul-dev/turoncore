---
import type { Lang, Translations } from '../i18n/ui';
import { getCollection } from 'astro:content';
import SectionHeading from './ui/SectionHeading.astro';
import Card from './ui/Card.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;

const allServices = await getCollection('services');
const services = allServices
  .filter((s) => s.data.locale === lang)
  .sort((a, b) => a.data.order - b.data.order);

const icons: Record<string, string> = {
  mobile: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  web: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  b2b: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
};
---

<section id="services" class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="reveal">
      <SectionHeading title={t.services.title} subtitle={t.services.subtitle} />
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        services.map((service, i) => (
          <div class:list={['reveal', `reveal-delay-${i + 1}`]}>
            <Card>
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald/10 text-emerald mb-5">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icons[service.data.icon]} />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-navy dark:text-white mb-2">
                {service.data.title}
              </h3>
              <p class="text-navy/60 dark:text-white/60 leading-relaxed">
                {service.data.description}
              </p>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>
