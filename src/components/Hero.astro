---
import type { Translations } from '../i18n/ui';
import GeometricBg from './GeometricBg.astro';
import Button from './ui/Button.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  <GeometricBg />

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-surface-light/50 dark:to-surface-dark/50" />

  <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-20 md:py-32">
    <div class="max-w-3xl">
      <span
        class="reveal inline-flex items-center gap-2 rounded-full glass border-emerald/30 px-4 py-1.5 text-sm font-medium text-emerald mb-6 glow-emerald"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald animate-pulse-glow" />
        {t.hero.badge}
      </span>

      <h1
        class="reveal reveal-delay-1 text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight text-navy dark:text-white leading-[1.1]"
      >
        {t.hero.title}
        <span class="text-gradient block mt-2">{t.hero.titleHighlight}</span>
      </h1>

      <p
        class="reveal reveal-delay-2 mt-6 text-lg md:text-xl text-navy/70 dark:text-white/70 leading-relaxed max-w-2xl"
      >
        {t.hero.subtitle}
      </p>

      <div class="reveal reveal-delay-3 mt-10 flex flex-wrap gap-4">
        <Button href="#contact" variant="primary" size="lg">
          {t.hero.ctaPrimary}
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </Button>
        <Button href="#services" variant="secondary" size="lg">
          {t.hero.ctaSecondary}
        </Button>
      </div>
    </div>
  </div>
</section>
