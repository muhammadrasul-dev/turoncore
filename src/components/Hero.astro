---
import type { Translations } from '../i18n/ui';
import GeometricBg from './GeometricBg.astro';
import Button from './ui/Button.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const metrics = [
  { value: '20+', label: t.about.stats.projects },
  { value: '15+', label: t.about.stats.clients },
  { value: '3+', label: t.about.stats.years },
];

const chips = [
  { label: 'Flutter', pos: 'top-[8%] left-[2%]', delay: '0s' },
  { label: 'React', pos: 'top-[34%] right-[-2%]', delay: '-2.4s' },
  { label: 'Node.js', pos: 'bottom-[14%] left-[6%]', delay: '-4.8s' },
];
---

<section class="relative flex min-h-[100svh] items-center overflow-hidden pt-28 pb-16 md:pt-32">
  <GeometricBg />

  <div class="shell relative">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8">
      <div>
        <span
          class="reveal inline-flex items-center gap-2 rounded-full bg-accent-soft px-3.5 py-1.5 text-xs font-semibold tracking-wide text-accent"
        >
          <span class="relative flex h-1.5 w-1.5">
            <span
              class="absolute inline-flex h-full w-full rounded-full bg-accent"
              style="animation: pulse-ring 2.4s ease-out infinite"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
          </span>
          {t.hero.badge}
        </span>

        <h1 class="display reveal mt-7 text-ink" style="--rd:80ms">
          {t.hero.title}
          <span class="accent-text block">{t.hero.titleHighlight}</span>
        </h1>

        <p class="lede reveal mt-7 max-w-xl" style="--rd:160ms">
          {t.hero.subtitle}
        </p>

        <div class="reveal mt-10 flex flex-wrap items-center gap-3" style="--rd:240ms">
          <Button href="#contact" variant="primary" size="lg">
            {t.hero.ctaPrimary}
            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h13M13 6l6 6-6 6"></path>
            </svg>
          </Button>
          <Button href="#services" variant="soft" size="lg">
            {t.hero.ctaSecondary}
          </Button>
        </div>

        <dl class="reveal mt-14 flex flex-wrap gap-x-12 gap-y-6" style="--rd:320ms">
          {
            metrics.map((metric) => (
              <div>
                <dt class="tabular font-display text-3xl font-extrabold text-ink md:text-4xl">
                  {metric.value}
                </dt>
                <dd class="mt-1 text-sm text-faint">{metric.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="reveal-scale relative hidden lg:block" style="--rd:200ms">
        <div class="relative mx-auto aspect-square w-full max-w-[440px]">
          <div
            class="absolute inset-[12%] rounded-full opacity-70 blur-[70px]"
            style="background:radial-gradient(circle, color-mix(in oklab, var(--c-accent) 40%, transparent), transparent 70%)"
          >
          </div>

          <svg class="relative h-full w-full" viewBox="0 0 400 400" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="strokeGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="var(--c-accent)" stop-opacity="0.9"></stop>
                <stop offset="100%" stop-color="var(--c-accent)" stop-opacity="0.05"></stop>
              </linearGradient>
              <linearGradient id="coreGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="var(--c-accent-bright)"></stop>
                <stop offset="100%" stop-color="var(--c-accent)"></stop>
              </linearGradient>
            </defs>

            <g class="anim-spin-slow" style="transform-origin:200px 200px">
              <circle
                cx="200"
                cy="200"
                r="190"
                stroke="url(#strokeGrad)"
                stroke-width="1"
                stroke-dasharray="2 10"
                opacity="0.6"></circle>
            </g>

            <g class="anim-spin-rev" style="transform-origin:200px 200px">
              <circle cx="200" cy="200" r="152" stroke="url(#strokeGrad)" stroke-width="1" opacity="0.5"
              ></circle>
              <circle cx="200" cy="48" r="4" fill="var(--c-accent)"></circle>
            </g>

            <g class="anim-spin-slow" style="transform-origin:200px 200px; animation-duration:120s">
              <rect
                x="96"
                y="96"
                width="208"
                height="208"
                rx="16"
                stroke="url(#strokeGrad)"
                stroke-width="1.5"></rect>
              <rect
                x="96"
                y="96"
                width="208"
                height="208"
                rx="16"
                stroke="url(#strokeGrad)"
                stroke-width="1.5"
                transform="rotate(45 200 200)"></rect>
            </g>

            <polygon
              points="200,140 252,170 252,230 200,260 148,230 148,170"
              fill="url(#coreGrad)"
              opacity="0.92"></polygon>
            <polygon
              points="200,140 252,170 252,230 200,260 148,230 148,170"
              fill="none"
              stroke="var(--c-accent-bright)"
              stroke-width="1"
              opacity="0.5"
              class="anim-float"
              style="transform-origin:200px 200px"></polygon>
          </svg>

          {
            chips.map((chip) => (
              <div
                class:list={['absolute anim-float', chip.pos]}
                style={`animation-delay:${chip.delay}`}
              >
                <span class="surface flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold text-muted">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent" />
                  {chip.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <a
    href="#services"
    class="absolute bottom-7 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-faint transition-colors duration-300 hover:text-accent md:flex"
    aria-label="Scroll"
  >
    <span class="text-[0.65rem] font-semibold uppercase tracking-[0.22em]">Scroll</span>
    <span class="relative h-9 w-px overflow-hidden bg-hairline">
      <span class="absolute inset-x-0 top-0 h-3 bg-accent" style="animation: scroll-hint 2s ease-in-out infinite"
      ></span>
    </span>
  </a>
</section>

<style>
  @keyframes scroll-hint {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(300%);
    }
  }
</style>
