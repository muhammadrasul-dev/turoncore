---
import type { Translations } from '../i18n/ui';
import GeometricBg from './GeometricBg.astro';
import Button from './ui/Button.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  <GeometricBg />

  <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-20 md:py-32">
    <div class="max-w-3xl">
      <span class="reveal inline-flex items-center gap-2 rounded-full border border-emerald/30 bg-emerald/10 px-4 py-1.5 text-sm font-medium text-emerald mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald animate-pulse" />
        {t.hero.badge}
      </span>

      <h1 class="reveal reveal-delay-1 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-navy dark:text-white leading-[1.1]">
        {t.hero.title}
        <span class="text-emerald"> {t.hero.titleHighlight}</span>
      </h1>

      <p class="reveal reveal-delay-2 mt-6 text-lg md:text-xl text-navy/60 dark:text-white/60 leading-relaxed max-w-2xl">
        {t.hero.subtitle}
      </p>

      <div class="reveal reveal-delay-3 mt-10 flex flex-wrap gap-4">
        <Button href="#contact" variant="primary" size="lg">
          {t.hero.ctaPrimary}
        </Button>
        <Button href="#services" variant="secondary" size="lg">
          {t.hero.ctaSecondary}
        </Button>
      </div>
    </div>
  </div>
</section>
