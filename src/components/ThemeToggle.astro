<button
  id="theme-toggle"
  type="button"
  class="group relative flex h-9 w-9 items-center justify-center rounded-full bg-inset text-muted transition-colors duration-300 hover:text-accent"
  aria-label="Toggle theme"
>
  <svg
    class="h-[1.05rem] w-[1.05rem] rotate-0 scale-100 transition-all duration-500 dark:-rotate-90 dark:scale-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="absolute h-[1.05rem] w-[1.05rem] rotate-90 scale-0 transition-all duration-500 dark:rotate-0 dark:scale-100"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20.4 14.9A8.5 8.5 0 1 1 9.1 3.6a6.6 6.6 0 0 0 11.3 11.3Z"></path>
  </svg>
</button>
