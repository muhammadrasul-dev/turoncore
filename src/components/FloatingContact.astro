---
import type { Lang, Translations } from '../i18n/ui';

interface Props {
  lang?: Lang;
  t: Translations;
}

const { t } = Astro.props;

const telegramHref = `https://t.me/${t.footer.telegram.replace('@', '')}`;
const instagramHref = `https://instagram.com/${t.contact.placeholders.instagram.replace('@', '')}`;
const youtubeHref = 'https://youtube.com/@turoncore';
const linkedinHref =
  'https://www.linkedin.com/search/results/companies/?keywords=TuronCore&origin=SWITCH_SEARCH_VERTICAL';
const emailHref = `mailto:${t.footer.email}`;
const messagesDay = t.floating.messagesDay;
const messagesEvening = t.floating.messagesEvening;
---

<div id="floating-contact">
  <div
    id="contact-bubble-stage"
    class="is-hidden"
    data-messages-day={JSON.stringify(messagesDay)}
    data-messages-evening={JSON.stringify(messagesEvening)}
    aria-live="polite"
  >
    <a id="contact-bubble-a" class="contact-bubble is-active" href="#contact">
      <span class="contact-bubble-text">{messagesDay[0]}</span>
    </a>
    <a id="contact-bubble-b" class="contact-bubble" href="#contact" aria-hidden="true" tabindex="-1">
      <span class="contact-bubble-text">{messagesDay[1] ?? messagesDay[0]}</span>
    </a>
  </div>

  <div class="contact-dock">
    <a href="#contact" class="contact-dock-cta">{t.floating.cta}</a>

    <div class="contact-dock-social">
      <div id="contact-popup" role="menu" aria-hidden="true">
        <a href={linkedinHref} target="_blank" rel="noopener noreferrer" role="menuitem">
          <span class="contact-menu-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="2" width="20" height="20" rx="2" />
              <path d="M8 11v5M8 8h.01M12 16v-5M16 16v-3.5c0-1.4-.8-2-2-2-1.2 0-1.7.7-2 1.2" stroke-linecap="round" />
            </svg>
          </span>
          LinkedIn
        </a>
        <a href={youtubeHref} target="_blank" rel="noopener noreferrer" role="menuitem">
          <span class="contact-menu-icon contact-menu-icon--youtube" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.517 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.871.507 9.388.507 9.388.507s7.517 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </span>
          YouTube
        </a>
        <a href={emailHref} role="menuitem">
          <span class="contact-menu-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </span>
          Email
        </a>
      </div>

      <a href={telegramHref} target="_blank" rel="noopener noreferrer" aria-label="Telegram">
        <svg viewBox="0 0 24 24" fill="#2AABEE">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.18-.08-.04-.19-.01-.27.01-.12.02-1.93 1.22-5.46 3.5-.52.36-.98.53-1.39.52-.46-.01-1.33-.26-1.98-.48-.8-.27-1.43-.42-1.37-.89.03-.25.38-.51 1.03-.78 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.64-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.16-.03.25z" />
        </svg>
      </a>
      <span class="contact-dock-divider" aria-hidden="true"></span>
      <a href={instagramHref} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 24 24">
          <defs>
            <radialGradient id="ig-float" cx="30%" cy="107%" r="150%">
              <stop offset="0%" stop-color="#fdf497" />
              <stop offset="45%" stop-color="#fd5949" />
              <stop offset="60%" stop-color="#d6249f" />
              <stop offset="90%" stop-color="#285AEB" />
            </radialGradient>
          </defs>
          <path
            fill="url(#ig-float)"
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 2.191 4.919 5.44.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 5.271-4.919 5.44-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-2.199-4.919-5.44-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-5.271 4.919-5.44 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
          />
        </svg>
      </a>
      <span class="contact-dock-divider" aria-hidden="true"></span>
      <button
        id="contact-toggle-btn"
        type="button"
        aria-label={t.floating.more}
        aria-expanded="false"
        aria-controls="contact-popup"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="5" cy="12" r="1.7"></circle>
          <circle cx="12" cy="12" r="1.7"></circle>
          <circle cx="19" cy="12" r="1.7"></circle>
        </svg>
      </button>
    </div>
  </div>
</div>

<style is:global>
  #floating-contact {
    position: fixed;
    right: 12px;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    width: max-content;
    max-width: min(22rem, calc(100vw - 24px));
    font-family: var(--font-sans);
  }

  @media (min-width: 640px) {
    #floating-contact {
      right: 24px;
      bottom: 24px;
    }
  }

  #contact-bubble-stage {
    position: relative;
    display: grid;
    justify-items: end;
    width: max-content;
    max-width: 100%;
    margin-bottom: 2px;
    transform-origin: right bottom;
  }

  #contact-bubble-stage.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.55);
  }

  #contact-bubble-stage.is-visible {
    opacity: 1;
    pointer-events: auto;
    animation: tc-stage-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  #floating-contact .contact-bubble {
    grid-area: 1 / 1;
    position: relative;
    display: none;
    width: max-content;
    max-width: 100%;
    align-items: center;
    border: 1px solid var(--c-hairline);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.96);
    color: var(--c-text);
    text-decoration: none;
    padding: 0.5rem 0.72rem 0.58rem 0.65rem;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
      0 1px 2px rgba(8, 19, 31, 0.04),
      0 8px 24px -8px rgba(8, 19, 31, 0.14);
    transform-origin: calc(100% - 10px) 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #floating-contact .contact-bubble::after {
    content: '';
    position: absolute;
    right: 12px;
    bottom: -6px;
    width: 12px;
    height: 12px;
    background: rgba(255, 255, 255, 0.96);
    border-right: 1px solid var(--c-hairline);
    border-bottom: 1px solid var(--c-hairline);
    transform: rotate(45deg);
    border-radius: 0 0 3px 0;
    box-shadow: 2px 2px 4px -2px rgba(8, 19, 31, 0.06);
  }

  #floating-contact .contact-bubble:hover {
    border-color: rgba(13, 155, 112, 0.28);
    box-shadow:
      var(--shadow-md),
      0 0 0 3px var(--c-accent-soft);
  }

  #floating-contact .contact-bubble.is-active,
  #floating-contact .contact-bubble.is-entering,
  #floating-contact .contact-bubble.is-leaving {
    display: inline-flex;
    visibility: visible;
  }

  #floating-contact .contact-bubble.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  #floating-contact .contact-bubble.is-entering {
    z-index: 1;
    pointer-events: auto;
    animation: tc-bubble-in 0.34s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  #floating-contact .contact-bubble.is-leaving {
    z-index: 2;
    animation: tc-bubble-out 0.26s cubic-bezier(0.4, 0, 0.8, 0.4) both;
    pointer-events: none;
  }

  #floating-contact .contact-bubble-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    max-width: min(16.5rem, calc(100vw - 4rem));
    overflow: hidden;
    white-space: normal;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.38;
    letter-spacing: -0.01em;
    color: var(--c-text);
  }

  #floating-contact .contact-dock {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #floating-contact .contact-dock-cta,
  #floating-contact .contact-dock-social {
    height: 44px;
    border-radius: 999px;
  }

  #floating-contact .contact-dock-cta {
    display: inline-flex;
    align-items: center;
    padding: 0 18px;
    background: var(--c-accent);
    color: var(--c-accent-ink);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.18) inset,
      0 10px 22px -10px rgba(13, 155, 112, 0.55);
  }

  #floating-contact .contact-dock-cta:hover {
    background: var(--c-accent-bright);
    color: var(--c-accent-ink);
  }

  #floating-contact .contact-dock-social {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 6px;
    border: 1px solid var(--c-hairline);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: var(--shadow-sm);
  }

  #floating-contact .contact-dock-social > a,
  #floating-contact .contact-dock-social > button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 0;
    background: transparent;
    color: var(--c-muted);
    cursor: pointer;
    border-radius: 999px;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }

  #floating-contact .contact-dock-social > a:hover,
  #floating-contact .contact-dock-social > button:hover,
  #contact-toggle-btn[aria-expanded='true'] {
    background: var(--c-accent-soft);
    color: var(--c-accent);
  }

  #floating-contact .contact-dock-social svg {
    width: 18px;
    height: 18px;
  }

  #floating-contact .contact-dock-divider {
    width: 1px;
    height: 14px;
    background: var(--c-hairline);
  }

  #contact-popup {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-width: 168px;
    padding: 8px;
    border: 1px solid var(--c-hairline);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-radius: 22px;
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.96);
    transform-origin: 85% 100%;
    transition:
      opacity 0.22s ease,
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.22s;
  }

  #contact-popup.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  #contact-popup a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    color: var(--c-text);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }

  #contact-popup a:hover {
    background: var(--c-accent-soft);
  }

  #floating-contact .contact-menu-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: var(--c-muted);
  }

  #floating-contact .contact-menu-icon svg {
    width: 20px;
    height: 20px;
  }

  #floating-contact .contact-menu-icon--telegram {
    color: #2aa3e0;
  }

  #floating-contact .contact-menu-icon--youtube {
    color: #ff0000;
  }

  @keyframes tc-stage-in {
    from {
      opacity: 0;
      transform: scale(0.55);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes tc-bubble-in {
    from {
      opacity: 0;
      transform: scale(0.55);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes tc-bubble-out {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #contact-bubble-stage,
    #floating-contact .contact-bubble,
    #contact-popup {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
