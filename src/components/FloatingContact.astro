---
import type { Lang, Translations } from '../i18n/ui';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;

const contactLinks = [
  {
    name: 'Telegram',
    href: `https://t.me/${t.footer.telegram.replace('@', '')}`,
    iconColor: 'bg-[#229ED9]/10 text-[#229ED9]',
    path: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.18-.08-.04-.19-.01-.27.01-.12.02-1.93 1.22-5.46 3.5-.52.36-.98.53-1.39.52-.46-.01-1.33-.26-1.98-.48-.8-.27-1.43-.42-1.37-.89.03-.25.38-.51 1.03-.78 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.64-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.16-.03.25z',
  },
  {
    name: 'Instagram',
    href: 'https://instagram.com/turoncore',
    iconColor: 'bg-[#E1306C]/10 text-[#E1306C]',
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 2.191 4.919 5.44.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 5.271-4.919 5.44-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-2.199-4.919-5.44-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-5.271 4.919-5.44 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4.162 4.162 0 1 1 0-8.324 4.162 4.162 0 0 1 0 8.324zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z',
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@turoncore',
    iconColor: 'bg-[#FF0000]/10 text-[#FF0000]',
    path: 'M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.517 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.871.507 9.388.507 9.388.507s7.517 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/search/results/companies/?keywords=TuronCore&origin=SWITCH_SEARCH_VERTICAL',
    iconColor: 'bg-[#0077B5]/10 text-[#0077B5]',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z',
  },
];

const contactDetails = [
  {
    name: t.footer.email,
    href: `mailto:${t.footer.email}`,
    iconColor: 'bg-accent-soft text-accent',
    svg: `<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`
  },
  {
    name: t.footer.phone,
    href: `tel:${t.footer.phone.replace(/\s/g, '')}`,
    iconColor: 'bg-accent-soft text-accent',
    svg: `<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.79 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`
  }
];
---

<div id="floating-contact" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3 font-sans">
  <!-- Popup Menu -->
  <div
    id="contact-popup"
    class="pointer-events-none invisible absolute bottom-16 right-0 mb-2 w-72 origin-bottom-right scale-95 rounded-2xl border border-white/[0.08] bg-[#0d0e12] p-3.5 text-white opacity-0 shadow-2xl transition-all duration-300 ease-out"
  >
    <div class="flex flex-col gap-1">
      <!-- Social Links -->
      {
        contactLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3.5 rounded-xl px-3 py-2.5 transition-all duration-200 hover:bg-white/[0.04]"
          >
            <span class={`flex h-9 w-9 items-center justify-center rounded-xl ${link.iconColor}`}>
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor">
                <path d={link.path} />
              </svg>
            </span>
            <span class="text-[0.95rem] font-medium text-[#edf2f6]">{link.name}</span>
          </a>
        ))
      }

      <!-- Divider -->
      <div class="my-1.5 h-px w-full bg-white/[0.06]" />

      <!-- Contact Details -->
      {
        contactDetails.map((detail) => (
          <a
            href={detail.href}
            class="flex items-center gap-3.5 rounded-xl px-3 py-2.5 transition-all duration-200 hover:bg-white/[0.04]"
          >
            <span class={`flex h-9 w-9 items-center justify-center rounded-xl ${detail.iconColor}`} set:html={detail.svg} />
            <span class="text-[0.95rem] font-medium text-[#edf2f6]">{detail.name}</span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- Toggle Button Row -->
  <div class="flex items-center gap-3">
    <!-- Pill Indicator -->
    <div
      id="contact-pill"
      class="flex items-center gap-2 rounded-full border border-white/[0.08] bg-[#0d0e12] py-2.5 pl-4 pr-5 text-sm font-semibold text-white shadow-xl backdrop-blur-md"
    >
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      <span>{t.nav.contact}</span>
    </div>

    <!-- Circular Toggle Button -->
    <button
      id="contact-toggle-btn"
      class="relative flex h-12 w-12 items-center justify-center rounded-full bg-accent text-accent-ink shadow-xl transition-all duration-300 hover:bg-accent-bright hover:scale-105 active:scale-95 cursor-pointer"
      aria-label="Toggle contact menu"
    >
      <!-- Chat Icon (Visible when closed) -->
      <svg
        id="chat-icon"
        class="h-5.5 w-5.5 transition-all duration-300"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>

      <!-- Close Icon (Hidden when closed) -->
      <svg
        id="close-icon"
        class="absolute h-5.5 w-5.5 scale-50 opacity-0 transition-all duration-300"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</div>
