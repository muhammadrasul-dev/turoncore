---
import type { Translations } from '../i18n/ui';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section id="tech" class="section relative overflow-hidden">
  <div class="shell relative">
    <SectionHeading
      eyebrow={t.tech.eyebrow}
      title={t.tech.title}
      subtitle={t.tech.subtitle}
      align="center"
      class="mb-12 md:mb-16"
    />

    <div class="grid gap-8 md:grid-cols-3 md:gap-6">
      {
        t.tech.categories.map((category, i) => (
          <div
            class="reveal surface border border-hairline/30 p-6 md:p-8"
            style={`--rd:${i * 100}ms`}
          >
            <h3 class="text-sm font-bold uppercase tracking-wider text-accent">{category.title}</h3>
            <div class="mt-5 flex flex-wrap gap-2">
              {
                category.items.map((item) => (
                  <span class="chip px-3 py-1.5 text-[0.8rem] font-semibold">{item}</span>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
