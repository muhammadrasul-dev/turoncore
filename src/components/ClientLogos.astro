---
import type { Translations } from '../i18n/ui';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const clients = [
  'Registon',
  'TechCorp',
  'BizSoft',
  'InnoLab',
  'DataHub',
  'CloudPro',
  'SmartSys',
  'CodeBase',
];
---

<section class="section-tight relative overflow-hidden">
  <div class="shell">
    <p class="reveal text-center text-xs font-semibold uppercase tracking-[0.22em] text-faint">
      {t.trust.title}
    </p>
  </div>

  <div class="marquee-host edge-fade reveal mt-10" style="--rd:100ms">
    <div class="marquee-track" style="--speed:46s">
      {
        [0, 1].map((set) => (
          <div class="flex shrink-0 items-center" aria-hidden={set === 1 ? 'true' : undefined}>
            {clients.map((name) => (
              <span class="group flex shrink-0 items-center gap-3 px-8 md:px-12">
                <span class="h-1.5 w-1.5 rotate-45 bg-accent/50 transition-colors duration-300 group-hover:bg-accent" />
                <span class="font-display text-xl font-extrabold tracking-tight text-faint transition-colors duration-300 group-hover:text-ink md:text-2xl">
                  {name}
                </span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
