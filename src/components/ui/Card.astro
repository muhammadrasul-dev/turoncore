---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class:list={[
    'group relative rounded-2xl overflow-hidden transition-all duration-500',
    className,
  ]}
>
  <!-- Gradient border effect -->
  <div
    class:list={[
      'absolute inset-0 rounded-2xl bg-gradient-to-br from-emerald/20 via-transparent to-navy/20 opacity-0 transition-opacity duration-500',
      hover && 'group-hover:opacity-100',
    ]}
  />

  <!-- Main content with glassmorphism -->
  <div
    class:list={[
      'relative glass rounded-2xl p-6 transition-all duration-500',
      hover && 'group-hover:shadow-xl group-hover:shadow-emerald/10',
    ]}
  >
    <slot />
  </div>

  <!-- Shine effect -->
  {
    hover && (
      <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-transparent via-white/10 to-transparent translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-1000" />
    )
  }
</div>
