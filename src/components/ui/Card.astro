---
interface Props {
  class?: string;
  hover?: boolean;
  spotlight?: boolean;
  padding?: 'sm' | 'md' | 'lg' | 'none';
  as?: 'div' | 'article' | 'li';
}

const {
  class: className = '',
  hover = true,
  spotlight = true,
  padding = 'md',
  as: Tag = 'div',
} = Astro.props;

const pads = {
  none: '',
  sm: 'p-5',
  md: 'p-6 md:p-7',
  lg: 'p-7 md:p-9',
};
---

<Tag
  class:list={[
    'group surface overflow-hidden',
    pads[padding],
    hover && 'lift',
    spotlight && hover && 'spot',
    spotlight && hover && 'js-spot',
    className,
  ]}
>
  <div class="relative z-10 h-full">
    <slot />
  </div>
</Tag>
