---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, subtitle, align = 'left', class: className = '' } = Astro.props;
const centered = align === 'center';
---

<div
  class:list={['max-w-2xl', centered && 'mx-auto text-center', className]}
>
  {
    eyebrow && (
      <span class:list={['eyebrow reveal', centered && 'justify-center']}>{eyebrow}</span>
    )
  }
  <h2 class="headline mt-5 text-ink reveal" style="--rd:70ms">{title}</h2>
  {
    subtitle && (
      <p class="lede mt-4 reveal" style="--rd:140ms">
        {subtitle}
      </p>
    )
  }
</div>
