---
interface Props {
  class?: string;
  markOnly?: boolean;
}

const { class: className = '', markOnly = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5 text-ink', className]}>
  <svg
    class="h-8 w-8 shrink-0 md:h-9 md:w-9"
    viewBox="0 0 48 48"
    fill="none"
    aria-hidden="true"
  >
    <g stroke="currentColor" stroke-width="2.6" stroke-linejoin="round">
      <rect x="10" y="10" width="28" height="28" rx="1.5"></rect>
      <rect x="10" y="10" width="28" height="28" rx="1.5" transform="rotate(45 24 24)"></rect>
    </g>
    <polygon
      points="32,24 28,30.9 20,30.9 16,24 20,17.1 28,17.1"
      fill="var(--c-accent)"
    ></polygon>
  </svg>

  {
    !markOnly && (
      <span class="font-display text-[1.35rem] leading-none tracking-[-0.045em] md:text-[1.5rem]">
        <span class="font-extrabold">Turon</span><span class="font-light">Core</span>
      </span>
    )
  }
</span>
