---
interface Props {
  class?: string;
  markOnly?: boolean;
}

const { class: className = '', markOnly = false } = Astro.props;
const isAlwaysDark = className.includes('!text-white') || className.includes('text-white');
---

<div class:list={['inline-flex items-center', className]}>
  {isAlwaysDark ? (
    <img
      src="/logos/logo-dark-bg.png"
      alt="TuronCore"
      class="h-8 w-auto object-contain md:h-9"
    />
  ) : (
    <>
      <img
        src="/logos/logo-light-bg.png"
        alt="TuronCore"
        class="h-8 w-auto object-contain md:h-9 dark:hidden"
      />
      <img
        src="/logos/logo-dark-bg.png"
        alt="TuronCore"
        class="hidden h-8 w-auto object-contain md:h-9 dark:block"
      />
    </>
  )}
</div>
