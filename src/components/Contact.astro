---
import type { Translations } from '../i18n/ui';
import GeometricBg from './GeometricBg.astro';
import Button from './ui/Button.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const contactItems = [
  {
    label: t.contact.info.phone,
    value: t.contact.placeholders.phone,
    href: `tel:${t.contact.placeholders.phone.replace(/\s/g, '')}`,
    path: 'M4.5 5.2c0-.9.7-1.7 1.6-1.7h2.1c.7 0 1.3.4 1.5 1.1l.9 2.7c.2.6 0 1.3-.6 1.7l-1.3.8a10.8 10.8 0 0 0 4.5 4.5l.8-1.3c.4-.6 1-.8 1.7-.6l2.7.9c.7.2 1.1.8 1.1 1.5v2.1c0 .9-.8 1.6-1.7 1.6C10.4 20.5 4.5 14.6 4.5 5.2Z',
  },
  {
    label: t.contact.info.email,
    value: t.contact.placeholders.email,
    href: `mailto:${t.contact.placeholders.email}`,
    path: 'M3.5 7.5 10.9 12c.7.4 1.5.4 2.2 0l7.4-4.5M4.5 19h15a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 19.5 5h-15A1.5 1.5 0 0 0 3 6.5v11A1.5 1.5 0 0 0 4.5 19Z',
  },
  {
    label: t.contact.info.telegram,
    value: t.contact.placeholders.telegram,
    href: `https://t.me/${t.contact.placeholders.telegram.replace('@', '')}`,
    path: 'm4 12 16-7-2.6 15-5-4.4L4 12Zm8.4 3.6L9.7 19v-4.4l8-6.6',
  },
  {
    label: t.contact.info.instagram,
    value: t.contact.placeholders.instagram,
    href: `https://instagram.com/${t.contact.placeholders.instagram.replace('@', '')}`,
    path: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm4.5 5.25a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5ZM17.625 6.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z',
  },
  {
    label: t.contact.info.address,
    value: t.contact.placeholders.address,
    href: null,
    path: 'M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  },
];
---

<section id="contact" class="section relative overflow-hidden">
  <GeometricBg grid={false} intensity="soft" />

  <div class="shell relative">
    <div class="surface reveal overflow-hidden p-7 md:p-12 lg:p-16">
      <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
        <div>
          <span class="eyebrow">{t.contact.eyebrow}</span>
          <h2 class="headline mt-5 text-ink">{t.contact.title}</h2>
          <p class="lede mt-5 max-w-md">{t.contact.subtitle}</p>

          <ul class="mt-10 space-y-2">
            {
              contactItems.map((item) => (
                <li>
                  <a
                    href={item.href ?? undefined}
                    class="group flex items-center gap-4 rounded-2xl px-3 py-3 transition-colors duration-300 hover:bg-accent-soft"
                    target={item.href?.startsWith('http') ? '_blank' : undefined}
                    rel={item.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    <span class="tile h-10 w-10 shrink-0">
                      <svg
                        class="h-[1.15rem] w-[1.15rem]"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d={item.path} />
                      </svg>
                    </span>
                    <span class="min-w-0">
                      <span class="block text-xs uppercase tracking-wider text-faint">
                        {item.label}
                      </span>
                      <span class="block truncate font-medium text-ink transition-colors duration-300 group-hover:text-accent">
                        {item.value}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <form id="contact-form" class="relative flex flex-col gap-4" novalidate>
          <input type="text" name="hp" class="hp-field" tabindex="-1" autocomplete="off" />
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-2 block text-sm font-medium text-muted">
                {t.contact.form.name}
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder={t.contact.form.namePlaceholder}
                class="field"
              />
            </div>
            <div>
              <label for="phone" class="mb-2 block text-sm font-medium text-muted">
                {t.contact.form.phone}
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-4 flex items-center gap-2 pointer-events-none z-10">
                  <svg class="h-3.5 w-5 rounded-[2px] shadow-xs" viewBox="0 0 125 60" fill="none">
                    <rect width="125" height="20" fill="#00a3da"/>
                    <rect y="20" width="125" height="2" fill="#ff4b5a"/>
                    <rect y="22" width="125" height="16" fill="#ffffff"/>
                    <rect y="38" width="125" height="2" fill="#ff4b5a"/>
                    <rect y="40" width="125" height="20" fill="#1fc153"/>
                  </svg>
                  <span class="text-sm font-semibold text-muted">+998</span>
                  <span class="h-4 w-px bg-hairline/80"></span>
                </div>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  autocomplete="tel"
                  placeholder={t.contact.form.phonePlaceholder}
                  class="field pl-24"
                />
              </div>
            </div>
          </div>

          <div>
            <label for="message" class="mb-2 block text-sm font-medium text-muted">
              {t.contact.form.message}
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder={t.contact.form.messagePlaceholder}
              class="field resize-none"></textarea>
          </div>

          <div class="mt-2 flex flex-wrap items-center gap-4">
            <Button type="submit" variant="primary" size="md">
              {t.contact.form.submit}
              <svg
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h13M13 6l6 6-6 6"></path>
              </svg>
            </Button>

            <p
              id="form-success"
              class="text-sm font-medium text-accent opacity-0 transition-opacity duration-500"
              role="status"
            >
              {t.contact.form.success}
            </p>
            <p
              id="form-error"
              class="text-sm font-medium text-red-500 opacity-0 transition-opacity duration-500"
              role="status"
            >
              {t.contact.form.error}
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

