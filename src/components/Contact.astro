---
import type { Translations } from '../i18n/ui';
import SectionHeading from './ui/SectionHeading.astro';
import Card from './ui/Card.astro';
import Button from './ui/Button.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const contactItems = [
  {
    label: t.contact.info.phone,
    value: t.contact.placeholders.phone,
    href: 'tel:+998000000000',
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  },
  {
    label: t.contact.info.email,
    value: t.contact.placeholders.email,
    href: `mailto:${t.contact.placeholders.email}`,
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    label: t.contact.info.telegram,
    value: t.contact.placeholders.telegram,
    href: 'https://t.me/turoncore',
    icon: 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8',
  },
  {
    label: t.contact.info.address,
    value: t.contact.placeholders.address,
    href: null,
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  },
];
---

<section id="contact" class="py-20 md:py-28 bg-navy/[0.02] dark:bg-white/[0.02]">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="reveal">
      <SectionHeading title={t.contact.title} subtitle={t.contact.subtitle} />
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="reveal reveal-delay-1">
        <Card hover={false}>
          <form id="contact-form" class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-medium text-navy dark:text-white mb-1.5">
                {t.contact.form.name}
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full rounded-xl border border-navy/10 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-3 text-navy dark:text-white placeholder:text-navy/30 dark:placeholder:text-white/30 focus:border-emerald focus:outline-none focus:ring-1 focus:ring-emerald transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-navy dark:text-white mb-1.5">
                {t.contact.form.email}
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-xl border border-navy/10 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-3 text-navy dark:text-white placeholder:text-navy/30 dark:placeholder:text-white/30 focus:border-emerald focus:outline-none focus:ring-1 focus:ring-emerald transition-colors"
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-navy dark:text-white mb-1.5">
                {t.contact.form.message}
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="w-full rounded-xl border border-navy/10 dark:border-white/10 bg-white dark:bg-white/5 px-4 py-3 text-navy dark:text-white placeholder:text-navy/30 dark:placeholder:text-white/30 focus:border-emerald focus:outline-none focus:ring-1 focus:ring-emerald transition-colors resize-none"
              />
            </div>
            <Button variant="primary" size="md" class="w-full sm:w-auto">
              {t.contact.form.submit}
            </Button>
            <p id="form-success" class="hidden text-sm text-emerald font-medium">
              {t.contact.form.success}
            </p>
          </form>
        </Card>
      </div>

      <div class="reveal reveal-delay-2 space-y-4">
        {
          contactItems.map((item) => (
            <Card>
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald/10 text-emerald">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                  </svg>
                </div>
                <div>
                  <div class="text-sm text-navy/50 dark:text-white/50">{item.label}</div>
                  {item.href ? (
                    <a
                      href={item.href}
                      class="text-navy dark:text-white font-medium hover:text-emerald transition-colors"
                      target={item.href.startsWith('http') ? '_blank' : undefined}
                      rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                      {item.value}
                    </a>
                  ) : (
                    <div class="text-navy dark:text-white font-medium">{item.value}</div>
                  )}
                </div>
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    success?.classList.remove('hidden');
    form.reset();
    setTimeout(() => success?.classList.add('hidden'), 5000);
  });
</script>
