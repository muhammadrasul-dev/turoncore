---
import type { Lang, Translations } from '../i18n/ui';
import { getCollection } from 'astro:content';
import SectionHeading from './ui/SectionHeading.astro';
import Card from './ui/Card.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;

const allProjects = await getCollection('portfolio');
const projects = allProjects
  .filter((p) => p.data.locale === lang)
  .sort((a, b) => a.data.order - b.data.order);

const categoryColors: Record<string, string> = {
  Web: 'bg-blue-500/10 text-blue-500',
  Mobile: 'bg-purple-500/10 text-purple-500',
  B2B: 'bg-orange-500/10 text-orange-500',
};
---

<section id="portfolio" class="py-20 md:py-28 bg-navy/[0.02] dark:bg-white/[0.02]">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="reveal">
      <SectionHeading title={t.portfolio.title} subtitle={t.portfolio.subtitle} />
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        projects.map((project, i) => (
          <div class:list={['reveal', `reveal-delay-${(i % 4) + 1}`]}>
            <Card class="h-full">
              <div class="aspect-video rounded-xl bg-gradient-to-br from-navy/5 to-emerald/10 dark:from-white/5 dark:to-emerald/10 mb-4 flex items-center justify-center">
                <span class="text-xs font-medium text-navy/30 dark:text-white/30 uppercase tracking-wider">
                  {t.portfolio.comingSoon}
                </span>
              </div>
              <span
                class:list={[
                  'inline-block px-2.5 py-0.5 rounded-full text-xs font-medium mb-3',
                  categoryColors[project.data.category] ?? 'bg-emerald/10 text-emerald',
                ]}
              >
                {project.data.category}
              </span>
              <h3 class="text-lg font-semibold text-navy dark:text-white mb-1">
                {project.data.title}
              </h3>
              <p class="text-sm text-navy/60 dark:text-white/60">{project.data.description}</p>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>
