      title={t.portfolio.title}
      subtitle={t.portfolio.subtitle}
      class="mb-12 md:mb-16"
    />

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-8">
      {
        currentStudies.map((project, i) => (
          <article
            class="group surface spot js-spot lift reveal overflow-hidden p-3 flex flex-col justify-between"
            style={`--rd:${(i % 3) * 90}ms`}
          >
            <div>
              <div
                class="relative aspect-[16/10] overflow-hidden rounded-[calc(var(--r-lg)-0.55rem)] flex items-center justify-center"
                style={`background:${palettes[i % palettes.length]}`}
              >
                <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>

                <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-[0.7rem] font-semibold tracking-wide text-white backdrop-blur-md">
                  {project.platform}
                </span>

                <span class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-black/25 px-3 py-1 text-[0.7rem] font-semibold text-white/90 backdrop-blur-md">
                  {project.inProcess ? inProcessLabel : project.stat}
                </span>

                <div class="z-10 text-center px-6">
                  <span class="block font-display text-[2rem] md:text-[2.4rem] font-black text-white/90 tracking-tight leading-none drop-shadow-md">
                    {project.title}
                  </span>
                  <span class="block text-[0.75rem] font-medium text-white/80 tracking-wide mt-2 max-w-[16rem] mx-auto">
                    {project.highlight}
                  </span>
                </div>

                <span class="absolute bottom-4 left-5 font-display text-[3.5rem] font-extrabold leading-none text-white/10 tabular">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>

              <div class="px-4 pt-6">
                <h3 class="text-xl font-bold text-ink transition-colors duration-300 group-hover:text-accent md:text-[1.35rem]">
                  {project.title}
                </h3>
                <p class="mt-2 text-[0.925rem] leading-relaxed text-muted">
                  {project.businessPurpose}
                </p>
              </div>
            </div>

            <div class="px-4 pb-3 pt-6 flex items-center justify-between border-t border-hairline/20 mt-6">
              <button
                type="button"
                data-open-case={project.id}
                class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-bright transition-colors cursor-pointer"
              >
                {tCta.details}
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13M13 6l6 6-6 6" />
                </svg>
              </button>

              <span class="text-xs font-semibold text-faint uppercase font-mono tracking-wider">
                {project.stack[0]} + {project.stack[1]}
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-10 text-center text-sm leading-relaxed text-faint max-w-2xl mx-auto" style="--rd:300ms">
      {t.portfolio.confidentiality}
    </p>
  </div>
</section>

<div id="case-study-overlay" class="fixed inset-0 z-[100] flex items-center justify-end bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-500">
  <div id="case-study-drawer" class="w-full max-w-2xl h-full bg-bg border-l border-hairline shadow-2xl flex flex-col justify-between translate-x-full transition-transform duration-500">
    <div class="p-6 md:p-8 border-b border-hairline flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="h-2.5 w-2.5 rounded-full bg-accent animate-pulse"></span>
        <h3 id="drawer-title" class="font-display text-2xl font-black text-ink">Project Title</h3>
      </div>
      <button id="close-drawer" type="button" class="flex h-9 w-9 items-center justify-center rounded-full bg-inset text-muted hover:text-ink hover:bg-inset-2 transition-colors cursor-pointer" aria-label="Close">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-6 md:p-8 space-y-8">
      <div class="p-4 rounded-2xl bg-accent-soft/40 border border-accent/15">
        <span class="block text-[0.65rem] font-bold text-accent uppercase tracking-widest font-mono">Scope & Platform</span>
        <span id="drawer-platform" class="block text-sm font-semibold text-ink mt-1">Platform details</span>
      </div>

      <div class="space-y-3">
        <h4 class="text-sm font-bold text-ink uppercase tracking-wider font-display flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-400"></span>
          {tCta.challenge}
        </h4>
        <p id="drawer-challenge" class="text-sm leading-relaxed text-muted">Challenge text</p>
      </div>

      <div class="space-y-3">
        <h4 class="text-sm font-bold text-ink uppercase tracking-wider font-display flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          {tCta.solution}
        </h4>
        <p id="drawer-solution" class="text-sm leading-relaxed text-muted">Solution text</p>
      </div>

      <div class="space-y-3.5">
        <h4 class="text-sm font-bold text-ink uppercase tracking-wider font-display flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-bright"></span>
          {tCta.features}
        </h4>
        <ul id="drawer-features" class="space-y-2.5 pl-0 list-none m-0">
        </ul>
      </div>

      <div class="space-y-4">
        <h4 class="text-sm font-bold text-ink uppercase tracking-wider font-display flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          {tCta.result}
        </h4>
        <div id="drawer-metrics" class="grid grid-cols-2 gap-3">
        </div>
      </div>

      <div class="space-y-3.5">
        <h4 class="text-sm font-bold text-ink uppercase tracking-wider font-display flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-faint"></span>
          {tCta.stack}
        </h4>
        <div id="drawer-stack" class="flex flex-wrap gap-2">
        </div>
      </div>
    </div>

    <div class="p-6 md:p-8 bg-inset/30 border-t border-hairline flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="text-[0.95rem] font-bold text-ink">{tCta.ctaHeading}</h4>
        <p class="text-xs text-muted mt-1 max-w-sm">{tCta.ctaSub}</p>
      </div>
      <button
        id="drawer-cta"
        type="button"
        class="btn btn-primary px-5 py-2.5 text-xs font-bold shrink-0 cursor-pointer"
      >
        {tCta.ctaButton}
      </button>
    </div>
  </div>
</div>

<script define:vars={{ currentStudies, tCta, inProcessLabel }}>
  function setupPortfolioDrawer() {
    const overlay = document.getElementById('case-study-overlay');
    const drawer = document.getElementById('case-study-drawer');
    const closeBtn = document.getElementById('close-drawer');
    const openBtns = document.querySelectorAll('[data-open-case]');
    const ctaBtn = document.getElementById('drawer-cta');

    if (!overlay || !drawer || !closeBtn || !ctaBtn) return;

    let activeProject = null;

    function badgeText(project) {
      return project.inProcess ? inProcessLabel : project.stat;
    }

    function openDrawer(projectId) {
      const project = currentStudies.find(p => p.id === projectId);
      if (!project) return;

      activeProject = project;

      document.getElementById('drawer-title').textContent = project.title;
      document.getElementById('drawer-platform').textContent = project.platform + ' • ' + badgeText(project);
      document.getElementById('drawer-challenge').textContent = project.challenge;
      document.getElementById('drawer-solution').textContent = project.solution;

      const featuresUl = document.getElementById('drawer-features');
      featuresUl.innerHTML = '';
      project.features.forEach(feat => {
        const li = document.createElement('li');
        li.className = 'relative pl-6 text-sm text-muted leading-relaxed';
        li.innerHTML = `<span class="absolute left-0 top-[3px] flex h-4.5 w-4.5 items-center justify-center rounded-full bg-accent/10 text-accent font-bold text-[9px]">✓</span>${feat}`;
        featuresUl.appendChild(li);
      });

      const metricsDiv = document.getElementById('drawer-metrics');
      metricsDiv.innerHTML = '';
      metricsDiv.className = project.metrics.length === 2
        ? 'grid grid-cols-2 gap-3'
        : 'grid grid-cols-3 gap-3';
      project.metrics.forEach(m => {
        const box = document.createElement('div');
        box.className = 'rounded-xl bg-inset/40 border border-hairline/25 p-3.5 text-center';
        box.innerHTML = `
          <span class="block font-display text-xl md:text-2xl font-black accent-text leading-none">${m.value}</span>
          <span class="block text-[0.625rem] font-bold text-faint uppercase tracking-wider mt-1.5 leading-tight">${m.label}</span>
        `;
        metricsDiv.appendChild(box);
      });

      const stackDiv = document.getElementById('drawer-stack');
      stackDiv.innerHTML = '';
      project.stack.forEach(tech => {
        const chip = document.createElement('span');
        chip.className = 'chip text-[0.675rem] px-2.5 py-1 font-semibold';
        chip.textContent = tech;
        stackDiv.appendChild(chip);
      });

      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100');
      drawer.classList.remove('translate-x-full');
      document.documentElement.classList.add('lenis-stopped');
    }

    function closeDrawer() {
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.add('translate-x-full');
      document.documentElement.classList.remove('lenis-stopped');
    }

    openBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-open-case');
        if (id) openDrawer(id);
      });
    });

    closeBtn.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeDrawer();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });

    ctaBtn.addEventListener('click', () => {
      const project = activeProject;
      closeDrawer();
      setTimeout(() => {
        const contactSection = document.getElementById('contact');
        if (contactSection) {
          contactSection.scrollIntoView({ behavior: 'smooth' });

          const messageField = document.querySelector('textarea[name="message"]') || document.getElementById('contact-message');
          if (messageField && project) {
            const autofill = {
              uz: `Men "${project.title}" loyihangizga o'xshash mahsulot yaratmoqchiman.`,
              en: `I am interested in building a product similar to your "${project.title}" project.`,
              ru: `Я хотел бы создать продукт, похожий на ваш проект "${project.title}".`
            };
            const currentLang = document.documentElement.lang || 'uz';
            messageField.value = autofill[currentLang] || autofill.uz;
          }
        }
      }, 550);
    });
  }

  setupPortfolioDrawer();
  document.addEventListener('astro:after-swap', setupPortfolioDrawer);
</script>
