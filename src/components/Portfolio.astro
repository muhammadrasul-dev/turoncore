---
import type { Lang, Translations } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/ui';
import { getProjects } from '../lib/content';
import SectionHeading from './ui/SectionHeading.astro';
import ProjectCover from './ProjectCover.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
const projects = await getProjects(lang);
---

<section id="portfolio" class="section band feather-top feather-bottom relative overflow-hidden">
  <div class="shell relative">
    <SectionHeading
      eyebrow={t.portfolio.eyebrow}
      title={t.portfolio.title}
      subtitle={t.portfolio.subtitle}
      class="mb-12 md:mb-16"
    />

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-8">
      {
        projects.map((project, i) => (
          <a
            href={getLocalizedPath(`/projects/${project.data.pageSlug}`, lang)}
            class="group surface spot js-spot lift reveal overflow-hidden p-3 flex flex-col justify-between"
            style={`--rd:${(i % 3) * 90}ms`}
          >
            <div>
              <ProjectCover title={project.data.title} highlight={project.data.highlight} index={i} />
              <div class="px-4 pt-6">
                <h3 class="text-xl font-bold text-ink transition-colors duration-300 group-hover:text-accent md:text-[1.35rem]">
                  {project.data.title}
                </h3>
                <p class="mt-2 text-[0.925rem] leading-relaxed text-muted">{project.data.description}</p>
              </div>
            </div>
            <div class="px-4 pb-3 pt-6 flex items-center justify-between border-t border-hairline/20 mt-6">
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-accent">
                {t.common.viewProject}
              </span>
              <span class="text-xs font-semibold text-faint uppercase font-mono tracking-wider">
                {project.data.stack.slice(0, 2).join(' + ')}
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="reveal mt-10 text-center text-sm leading-relaxed text-faint max-w-2xl mx-auto" style="--rd:300ms">
      {t.portfolio.confidentiality}
    </p>
  </div>
</section>
