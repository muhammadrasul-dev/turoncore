---
import type { Lang, Translations } from '../i18n/ui';
import { getCollection } from 'astro:content';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;

const allProjects = await getCollection('portfolio');
const projects = allProjects
  .filter((p) => p.data.locale === lang)
  .sort((a, b) => a.data.order - b.data.order);

const palettes = [
  'linear-gradient(135deg, #0f9b7a 0%, #0b3b52 100%)',
  'linear-gradient(135deg, #5b47c9 0%, #131a3a 100%)',
  'linear-gradient(135deg, #c9663f 0%, #2a1630 100%)',
  'linear-gradient(135deg, #1f7fd4 0%, #0b2340 100%)',
];
---

<section id="portfolio" class="section band feather-top feather-bottom relative overflow-hidden">
  <div class="shell relative">
    <SectionHeading
      eyebrow={t.portfolio.eyebrow}
      title={t.portfolio.title}
      subtitle={t.portfolio.subtitle}
      class="mb-12 md:mb-16"
    />

    <div class="grid gap-5 md:grid-cols-2 md:gap-6">
      {
        projects.map((project, i) => {
          const Component = project.data.link ? 'a' : 'article';
          const linkProps = project.data.link
            ? { href: project.data.link, target: '_blank', rel: 'noopener noreferrer' }
            : {};
          return (
            <Component
              {...linkProps}
              class="group surface spot js-spot lift reveal overflow-hidden p-3"
              style={`--rd:${(i % 2) * 110}ms`}
            >
              <div
                class="relative aspect-[16/10] overflow-hidden rounded-[calc(var(--r-lg)-0.55rem)]"
                style={`background:${palettes[i % palettes.length]}`}
              >
                <div
                  class="absolute inset-0 opacity-30 transition-transform duration-[1.2s] group-hover:scale-110"
                  style="background-image:radial-gradient(rgba(255,255,255,.35) 1px, transparent 1px);background-size:22px 22px"
                  aria-hidden="true"
                />
                <div
                  class="absolute inset-0 bg-linear-to-t from-black/45 via-transparent to-transparent"
                  aria-hidden="true"
                />

                <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-[0.7rem] font-semibold tracking-wide text-white backdrop-blur-md">
                  {project.data.category}
                </span>

                <span class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-black/25 px-3 py-1 text-[0.7rem] font-semibold text-white/90 backdrop-blur-md">
                  <svg class="h-3 w-3 text-white" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 1.8l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L2.2 7.5l5.4-.8L10 1.8z" />
                  </svg>
                  5.0
                </span>

                <span class="absolute bottom-4 left-5 font-display text-[3.5rem] font-extrabold leading-none text-white/15 tabular">
                  {String(i + 1).padStart(2, '0')}
                </span>

                {project.data.link && (
                  <span class="absolute bottom-4 right-4 inline-flex items-center gap-1 rounded-full bg-white/10 px-3 py-1 text-[0.7rem] font-medium text-white backdrop-blur-md transition-all duration-300 group-hover:bg-white/20">
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
                    </svg>
                  </span>
                )}
              </div>

              <div class="flex items-end justify-between gap-6 px-4 pb-4 pt-6">
                <div>
                  <h3 class="text-xl font-bold text-ink transition-colors duration-300 group-hover:text-accent md:text-[1.35rem]">
                    {project.data.title}
                  </h3>
                  <p class="mt-2 max-w-md text-[0.95rem] leading-relaxed text-muted">
                    {project.data.description}
                  </p>
                </div>

                <span
                  class="tile h-11 w-11 shrink-0 transition-transform duration-500 group-hover:-rotate-45"
                  aria-hidden="true"
                >
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h13M13 6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </Component>
          );
        })
      }
    </div>
  </div>
</section>
