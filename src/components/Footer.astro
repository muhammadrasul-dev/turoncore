---
import type { Lang, Translations } from '../i18n/ui';
import Logo from './ui/Logo.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
const year = new Date().getFullYear();

const footerLinks = [
  { href: '#services', label: t.footer.solutions },
  { href: '#portfolio', label: t.footer.works },
  { href: '#sectors', label: t.footer.fields },
  { href: '#process', label: t.footer.process },
  { href: '#about', label: t.footer.about },
  { href: '#audit', label: t.nav.audit },
];

const socials = [
  {
    name: 'Telegram',
    href: `https://t.me/${t.footer.telegram.replace('@', '')}`,
    path: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.18-.08-.04-.19-.01-.27.01-.12.02-1.93 1.22-5.46 3.5-.52.36-.98.53-1.39.52-.46-.01-1.33-.26-1.98-.48-.8-.27-1.43-.42-1.37-.89.03-.25.38-.51 1.03-.78 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.64-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.16-.03.25z',
  },
  {
    name: 'Instagram',
    href: 'https://instagram.com/turoncore',
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 2.191 4.919 5.44.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 5.271-4.919 5.44-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-2.199-4.919-5.44-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-5.271 4.919-5.44 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4.162 4.162 0 1 1 0-8.324 4.162 4.162 0 0 1 0 8.324zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z',
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@turoncore',
    path: 'M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.517 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.871.507 9.388.507 9.388.507s7.517 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/search/results/companies/?keywords=TuronCore&origin=SWITCH_SEARCH_VERTICAL',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z',
  },
];
---

<footer class="band feather-top relative overflow-hidden bg-[#06080c] text-white">
  <div class="shell relative pt-16 md:pt-24">
    <div class="grid gap-12 pb-14 md:grid-cols-[1.4fr_1fr_1.2fr] md:gap-8 md:pb-20">
      <!-- Left Column: Logo, Tagline, Contact Details, Socials -->
      <div class="flex flex-col items-start">
        <a href={`/${lang}/`} class="inline-flex items-center gap-2.5" aria-label="TuronCore">
          <Logo class="!text-white" />
        </a>
        
        <p class="mt-5 max-w-xs text-[0.95rem] leading-relaxed text-[#94a3b8]">
          {t.footer.tagline}
        </p>

        <!-- Contact Items with Icons -->
        <ul class="mt-6 space-y-3.5">
          <li>
            <a href={`https://t.me/${t.footer.telegram.replace('@', '')}`} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 text-[0.95rem] text-[#94a3b8] transition-colors duration-300 hover:text-white">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/[0.03] text-[#94a3b8] transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m22 2-7 20-4-9-9-4Z"/>
                  <path d="M22 2 11 13"/>
                </svg>
              </span>
              <span>{t.footer.telegram}</span>
            </a>
          </li>
          <li>
            <a href={`tel:${t.footer.phone.replace(/\s/g, '')}`} class="group flex items-center gap-3 text-[0.95rem] text-[#94a3b8] transition-colors duration-300 hover:text-white">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/[0.03] text-[#94a3b8] transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.79 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <span>{t.footer.phone}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${t.footer.email}`} class="group flex items-center gap-3 text-[0.95rem] text-[#94a3b8] transition-colors duration-300 hover:text-white">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/[0.03] text-[#94a3b8] transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </span>
              <span>{t.footer.email}</span>
            </a>
          </li>
        </ul>

        <!-- Social Icons Row -->
        <div class="mt-8 flex gap-3">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.03] text-[#94a3b8] transition-all duration-300 hover:-translate-y-1 hover:bg-blue-600 hover:text-white"
              >
                <svg
                  class="h-[1.1rem] w-[1.1rem]"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d={social.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Middle Column: Navigation Links -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#64748b]">
          {t.footer.navigation}
        </h3>
        <ul class="mt-6 space-y-4">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group inline-flex items-center text-[0.95rem] text-[#94a3b8] transition-colors duration-300 hover:text-white"
                >
                  <span class="mr-0 h-px w-0 bg-blue-500 transition-all duration-300 group-hover:mr-2.5 group-hover:w-4" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right Column: Contact CTA & Button -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#64748b]">
          {t.footer.contact}
        </h3>
        <p class="mt-6 text-[0.95rem] leading-relaxed text-[#94a3b8]">
          {t.footer.contactText}
        </p>
        <div class="mt-8">
          <a
            href="#contact"
            class="inline-flex items-center gap-4 rounded-full bg-blue-600 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/20 hover:-translate-y-0.5"
          >
            <span>{t.footer.ctaButton}</span>
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-white/20 text-white">
              <svg
                class="h-3.5 w-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div
      class="h-px w-full bg-white/[0.05]"
      aria-hidden="true"
    >
    </div>

    <!-- Bottom Row: Copyright & Links -->
    <div class="flex flex-wrap items-center justify-between gap-4 py-7 text-sm text-[#64748b]">
      <p>&copy; {year} TuronCore - {t.footer.rights}</p>
      <div class="flex gap-6">
        <a href="#" class="transition-colors duration-300 hover:text-white">{t.footer.privacy}</a>
        <a href="#" class="transition-colors duration-300 hover:text-white">{t.footer.terms}</a>
        <span class="text-white/[0.05]">|</span>
        <span class="text-[#64748b]">{t.footer.createdIn}</span>
      </div>
    </div>
  </div>

  <!-- Background Text -->
  <div
    class="pointer-events-none select-none overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="shell translate-y-[20%] font-display text-[clamp(2.75rem,10.5vw,9.5rem)] font-extrabold leading-[0.8] tracking-tighter whitespace-nowrap text-white/[0.01]"
    >
      TURONCORE
    </div>
  </div>
</footer>
