---

<footer class="band feather-top relative overflow-hidden bg-[#06080c] text-white">
  <div class="shell relative pt-16 md:pt-24">
    <div class="grid gap-12 pb-14 md:grid-cols-[1.4fr_1fr_1.2fr] md:gap-8 md:pb-20">
      <!-- Left Column: Logo, Tagline, Contact Details, Socials -->
      <div class="flex flex-col items-start">
        <a href={`/${lang}/`} class="inline-flex items-center gap-2.5" aria-label="Unical">
          <svg class="h-8 w-8 shrink-0 md:h-9 md:w-9" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 4V14C6 17.3137 8.68629 20 12 20C15.3137 20 18 17.3137 18 14V4" stroke="url(#unical-grad)" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M12 9V14" stroke="url(#unical-grad)" stroke-width="3.5" stroke-linecap="round"/>
            <defs>
              <linearGradient id="unical-grad" x1="6" y1="4" x2="18" y2="20" gradientUnits="userSpaceOnUse">
                <stop stop-color="#3b82f6"/>
                <stop offset="1" stop-color="#6366f1"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="font-sans text-2xl font-bold tracking-tight text-white">
            Unical<span class="text-blue-500">.</span>
          </span>
        </a>
        
        <p class="mt-5 max-w-xs text-[0.95rem] leading-relaxed text-[#94a3b8]">
          {t.footer.tagline}
        </p>

        <!-- Contact Items with Icons -->
        <ul class="mt-6 space-y-3.5">
          <li>
            <a href="https://t.me/unical_uz" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 text-[0.95rem] text-[#94a3b8] transition-colors duration-300 hover:text-white">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/[0.03] text-[#94a3b8] transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m22 2-7 20-4-9-9-4Z"/>
                  <path d="M22 2 11 13"/>
                </svg>
              </span>
              <span>{t.footer.telegram}</span>
            </a>
          </li>
          <li>
            <a href="tel:+998933893700" class="group flex items-center gap-3 text-[0.95rem] text-[#94a3b8] transition-colors duration-300 hover:text-white">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/[0.03] text-[#94a3b8] transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.79 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <span>{t.footer.phone}</span>
            </a>
          </li>
          <li>
            <a href="mailto:hello@unical.uz" class="group flex items-center gap-3 text-[0.95rem] text-[#94a3b8] transition-colors duration-300 hover:text-white">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/[0.03] text-[#94a3b8] transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </span>
              <span>{t.footer.email}</span>
            </a>
          </li>
        </ul>

        <!-- Social Icons Row -->
        <div class="mt-8 flex gap-3">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.03] text-[#94a3b8] transition-all duration-300 hover:-translate-y-1 hover:bg-blue-600 hover:text-white"
              >
                <svg
                  class="h-[1.1rem] w-[1.1rem]"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d={social.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Middle Column: Navigation Links -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#64748b]">
          {t.footer.navigation}
        </h3>
        <ul class="mt-6 space-y-4">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group inline-flex items-center text-[0.95rem] text-[#94a3b8] transition-colors duration-300 hover:text-white"
                >
                  <span class="mr-0 h-px w-0 bg-blue-500 transition-all duration-300 group-hover:mr-2.5 group-hover:w-4" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right Column: Contact CTA & Button -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#64748b]">
          {t.footer.contact}
        </h3>
        <p class="mt-6 text-[0.95rem] leading-relaxed text-[#94a3b8]">
          {t.footer.contactText}
        </p>
        <div class="mt-8">
          <a
            href="#contact"
            class="inline-flex items-center gap-4 rounded-full bg-blue-600 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/20 hover:-translate-y-0.5"
          >
            <span>{t.footer.ctaButton}</span>
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-white/20 text-white">
              <svg
                class="h-3.5 w-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div
      class="h-px w-full bg-white/[0.05]"
      aria-hidden="true"
    >
    </div>

    <!-- Bottom Row: Copyright & Links -->
    <div class="flex flex-wrap items-center justify-between gap-4 py-7 text-sm text-[#64748b]">
      <p>&copy; {year} Unical IT - {t.footer.rights}</p>
      <div class="flex gap-6">
        <a href="#" class="transition-colors duration-300 hover:text-white">{t.footer.privacy}</a>
        <a href="#" class="transition-colors duration-300 hover:text-white">{t.footer.terms}</a>
        <span class="text-white/[0.05]">|</span>
        <span class="text-[#64748b]">{t.footer.createdIn}</span>
      </div>
    </div>
  </div>

  <!-- Background Text -->
  <div
    class="pointer-events-none select-none overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="shell translate-y-[20%] font-display text-[clamp(2.75rem,10.5vw,9.5rem)] font-extrabold leading-[0.8] tracking-tighter whitespace-nowrap text-white/[0.01]"
    >
      UNICAL
    </div>
  </div>
</footer>
