---
import type { Translations } from '../i18n/ui';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const partners = [
  {
    name: 'Fasgo',
    label: t.partners.fasgo,
  },
  {
    name: 'Jr Techno',
    label: t.partners.jrtechno,
  },
  {
    name: 'YaqinTV',
    label: t.partners.yaqintv,
  },
];
---

<section class="section-tight relative overflow-hidden">
  <div class="shell relative">
    <SectionHeading
      eyebrow={t.certificates.eyebrow}
      title={t.certificates.title}
      subtitle={t.certificates.subtitle}
      align="center"
      class="mb-12 md:mb-16"
    />

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-5">
      {
        partners.map((partner, i) => (
          <div
            class="group surface spot js-spot lift reveal flex flex-col items-center gap-4 p-7 text-center"
            style={`--rd:${i * 90}ms`}
          >
            <span class="tile h-12 w-12 font-display text-lg font-bold">
              {partner.name.charAt(0)}
            </span>
            <span>
              <span class="block font-semibold text-ink">{partner.name}</span>
              <span class="mt-1 block text-xs text-faint">{partner.label}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
