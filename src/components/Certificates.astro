---
import type { Translations } from '../i18n/ui';
import Card from './ui/Card.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const certificates = [
  {
    name: 'AWS Cloud',
    label: 'Certified Partner',
    icon: '☁️',
  },
  {
    name: 'Google Cloud',
    label: 'Technology Partner',
    icon: '🔵',
  },
  {
    name: 'Microsoft Azure',
    label: 'Verified Partner',
    icon: '🔷',
  },
  {
    name: 'Flutter',
    label: 'Expert Developers',
    icon: '🦋',
  },
];
---

<section class="py-16 md:py-20 bg-navy/[0.02] dark:bg-white/[0.02]">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-navy dark:text-white mb-4">
        {t.footer.links === 'Havolalar' ? 'Hamkorlik sertifikatlari' : t.footer.links === 'Ссылки' ? 'Партнёрские сертификаты' : 'Partnership Certificates'}
      </h2>
      <p class="text-navy/60 dark:text-white/60">
        {
          t.footer.links === 'Havolalar'
            ? 'Texnologiya hamkorlari va sertifikatlar'
            : t.footer.links === 'Ссылки'
              ? 'Технологические партнёры и сертификаты'
              : 'Technology partners and certifications'
        }
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {
        certificates.map((cert, i) => (
          <div class:list={['reveal group', `reveal-delay-${i + 1}`]}>
            <Card>
              <div class="text-center">
                <div class="text-4xl mb-3 group-hover:scale-110 transition-transform duration-300">
                  {cert.icon}
                </div>
                <div class="font-semibold text-navy dark:text-white mb-1">{cert.name}</div>
                <div class="text-xs text-navy/50 dark:text-white/50">{cert.label}</div>
              </div>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>