---
import type { Lang, Translations } from '../i18n/ui';
import { getCollection } from 'astro:content';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;

const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials
  .filter((review) => review.data.locale === lang)
  .sort((a, b) => a.data.order - b.data.order);

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section id="testimonials" class="section relative overflow-hidden">
  <div class="shell relative">
    <SectionHeading
      eyebrow={t.testimonials.eyebrow}
      title={t.testimonials.title}
      subtitle={t.testimonials.subtitle}
      align="center"
      class="mb-12 md:mb-16"
    />

    <div class="grid gap-5 md:grid-cols-3 md:gap-6">
      {
        testimonials.map((testimonial, i) => (
          <figure
            class="group surface spot js-spot lift reveal relative flex flex-col overflow-hidden p-8"
            style={`--rd:${i * 100}ms`}
          >
            <svg
              class="absolute right-6 top-5 h-14 w-14 text-accent/10 transition-colors duration-500 group-hover:text-accent/20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M9.6 5.5C6.3 7 4.5 9.8 4.5 13.2c0 3.2 1.9 5.3 4.5 5.3 2.2 0 3.8-1.6 3.8-3.7 0-2-1.4-3.5-3.3-3.5-.4 0-.8.1-1 .2.4-1.6 1.9-3.2 3.8-4.2l-2.7-1.8Zm9.3 0C15.6 7 13.8 9.8 13.8 13.2c0 3.2 1.9 5.3 4.5 5.3 2.2 0 3.8-1.6 3.8-3.7 0-2-1.4-3.5-3.3-3.5-.4 0-.8.1-1 .2.4-1.6 1.9-3.2 3.8-4.2l-2.7-1.8Z" />
            </svg>

            <div class="relative z-10 flex gap-0.5" aria-label="5 / 5">
              {[0, 1, 2, 3, 4].map(() => (
                <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 1.8l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L2.2 7.5l5.4-.8L10 1.8z" />
                </svg>
              ))}
            </div>

            <blockquote class="relative z-10 mt-5 flex-1 text-[1.02rem] leading-relaxed text-muted">
              {testimonial.body}
            </blockquote>

            <figcaption class="relative z-10 mt-8 flex items-center gap-3.5">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent-soft font-display text-sm font-extrabold text-accent">
                {initials(testimonial.data.author)}
              </span>
              <span class="min-w-0">
                <span class="block truncate font-semibold text-ink">{testimonial.data.author}</span>
                <span class="block truncate text-sm text-faint">
                  {testimonial.data.position}, {testimonial.data.company}
                </span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
