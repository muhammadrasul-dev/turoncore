---
import type { Lang, Translations } from '../i18n/ui';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
---

<div
  id="contact-modal-backdrop"
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-[#05070b]/60 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-500 ease-out"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Modal Dialog -->
  <div
    id="contact-modal-dialog"
    class="relative w-full max-w-4xl rounded-[2rem] border border-hairline bg-bg-soft/95 p-6 md:p-10 lg:p-12 shadow-2xl backdrop-blur-xl transition-all duration-500 cubic-bezier(0.16, 1, 0.3, 1) scale-95 translate-y-4 opacity-0"
  >
    <!-- Close Button -->
    <button
      id="contact-modal-close"
      class="absolute top-5 right-5 flex h-10 w-10 items-center justify-center rounded-full border border-hairline bg-surface/50 text-faint transition-all duration-300 hover:bg-inset hover:text-ink hover:scale-105 active:scale-95 cursor-pointer z-10"
      aria-label="Close modal"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Content Layout -->
    <div class="grid gap-10 lg:grid-cols-[0.42fr_0.58fr] lg:gap-14">
      
      <!-- Left Column: Contact Links and QR -->
      <div class="flex flex-col justify-between">
        <div>
          <!-- Badge -->
          <span class="inline-flex items-center gap-1.5 text-[0.7rem] font-extrabold uppercase tracking-[0.2em] text-accent">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            TuronCore
          </span>

          <h2 id="modal-title" class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mt-4 leading-tight">
            {t.modal.title}
          </h2>
          <p class="text-sm text-muted mt-3 leading-relaxed">
            {t.modal.subtitle}
          </p>
        </div>

        <!-- Logo / Brand Showcase container -->
        <div class="hidden sm:flex items-center gap-5 mt-6 p-4 rounded-2xl border border-hairline bg-surface/50 backdrop-blur-md">
          <div class="shrink-0 flex items-center justify-center p-3 rounded-2xl bg-white/[0.03] border border-white/[0.06] shadow-inner transition-all duration-500 hover:scale-105 group/logo">
            <svg
              class="h-10 w-10 text-accent transition-transform duration-500 group-hover/logo:rotate-45"
              viewBox="0 0 48 48"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g stroke="currentColor" stroke-width="2.6" stroke-linejoin="round">
                <rect x="10" y="10" width="28" height="28" rx="1.5"></rect>
                <rect x="10" y="10" width="28" height="28" rx="1.5" transform="rotate(45 24 24)"></rect>
              </g>
              <polygon
                points="32,24 28,30.9 20,30.9 16,24 20,17.1 28,17.1"
                fill="var(--c-accent)"
              ></polygon>
            </svg>
          </div>
          <div>
            <p class="font-display text-sm font-extrabold text-ink tracking-wide">
              Turon<span class="text-accent">Core</span>
            </p>
            <p class="text-xs text-muted mt-1">
              Digital Engineering Studio
            </p>
          </div>
        </div>

        <!-- Buttons row/column -->
        <div class="flex flex-col gap-3 mt-6 lg:mt-8">
          <!-- Telegram Button -->
          <a
            href={`https://t.me/${t.footer.telegram.replace('@', '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-full items-center justify-center gap-3 rounded-2xl bg-[#229ED9] px-5 py-3.5 text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:bg-[#1d8cc2] hover:scale-[1.01] active:scale-[0.99]"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.18-.08-.04-.19-.01-.27.01-.12.02-1.93 1.22-5.46 3.5-.52.36-.98.53-1.39.52-.46-.01-1.33-.26-1.98-.48-.8-.27-1.43-.42-1.37-.89.03-.25.38-.51 1.03-.78 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.64-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.16-.03.25z"/>
            </svg>
            {t.modal.telegramBtn}
          </a>

          <!-- Call us button -->
          <a
            href={`tel:${t.footer.phone.replace(/\s/g, '')}`}
            class="group flex w-full items-center justify-center gap-3 rounded-2xl border border-hairline bg-surface/50 px-5 py-3.5 text-sm font-semibold text-ink transition-all duration-300 hover:bg-inset hover:scale-[1.01] active:scale-[0.99]"
          >
            <svg
              class="h-4.5 w-4.5 text-accent group-hover:text-accent-bright transition-colors"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.79 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {t.modal.callBtn}
          </a>
        </div>
      </div>

      <!-- Right Column: Form Block -->
      <div class="relative flex flex-col justify-center">
        <!-- Success Overlay (hidden by default) -->
        <div
          id="modal-success-screen"
          class="absolute inset-0 z-20 flex flex-col items-center justify-center text-center bg-bg-soft/95 opacity-0 pointer-events-none transition-all duration-500 rounded-2xl"
        >
          <div class="h-16 w-16 flex items-center justify-center rounded-full bg-accent-soft text-accent border border-accent/20 mb-6 scale-90 transition-transform duration-500" id="modal-success-icon">
            <svg
              class="h-8 w-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-ink mb-3">{t.contact.form.success}</h3>
          <p class="text-sm text-muted max-w-sm px-4">
            {t.modal.success}
          </p>
        </div>

        <!-- Section separator/header -->
        <div class="relative flex py-3 items-center mb-5">
          <div class="grow border-t border-hairline/60"></div>
          <span class="mx-4 text-[10px] font-extrabold uppercase tracking-widest text-faint">
            {t.modal.orLeaveRequest}
          </span>
          <div class="grow border-t border-hairline/60"></div>
        </div>

        <!-- Fast Request Form -->
        <form id="contact-modal-form" class="flex flex-col gap-4" novalidate>
          <!-- Name Input -->
          <div>
            <label for="modal-name" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted">
              {t.modal.formName}
            </label>
            <input
              type="text"
              id="modal-name"
              name="name"
              required
              autocomplete="name"
              placeholder={t.modal.formNamePlaceholder}
              class="field"
            />
          </div>

          <!-- Phone Input (With premium flag and custom layout) -->
          <div>
            <label for="modal-phone" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted">
              {t.modal.formPhone}
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-4 flex items-center gap-2 pointer-events-none z-10">
                <!-- Detailed Uzbekistan flag SVG -->
                <svg class="h-3.5 w-5 rounded-[2px] shadow-xs" viewBox="0 0 125 60" fill="none">
                  <rect width="125" height="20" fill="#00a3da"/>
                  <rect y="20" width="125" height="2" fill="#ff4b5a"/>
                  <rect y="22" width="125" height="16" fill="#ffffff"/>
                  <rect y="38" width="125" height="2" fill="#ff4b5a"/>
                  <rect y="40" width="125" height="20" fill="#1fc153"/>
                </svg>
                <span class="text-sm font-semibold text-muted">+998</span>
                <span class="h-4 w-px bg-hairline/80"></span>
              </div>
              <input
                type="tel"
                id="modal-phone"
                name="phone"
                required
                placeholder={t.modal.formPhonePlaceholder}
                class="field pl-24"
              />
            </div>
          </div>

          <!-- Project Sector Selection Dropdown -->
          <div>
            <label for="modal-sector" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted">
              {t.modal.formSector}
            </label>
            <div class="relative">
              <select
                id="modal-sector"
                name="sector"
                required
                class="field pr-10 appearance-none bg-inset cursor-pointer"
              >
                <option value="" disabled selected>{t.modal.formSectorPlaceholder}</option>
                {t.sectors.items.map((item) => (
                  <option value={item.title}>{item.title}</option>
                ))}
                <option value="Other / Boshqa">Other / Boshqa</option>
              </select>
              <!-- Custom dropdown arrow indicator -->
              <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-faint">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Message input -->
          <div>
            <label for="modal-message" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted">
              {t.modal.formMessage}
            </label>
            <textarea
              id="modal-message"
              name="message"
              rows="3"
              placeholder={t.modal.formMessagePlaceholder}
              class="field resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="mt-2">
            <button
              type="submit"
              class="group flex w-full items-center justify-center gap-2 rounded-2xl bg-accent px-5 py-3.5 text-sm font-bold text-accent-ink shadow-lg transition-all duration-300 hover:bg-accent-bright hover:scale-[1.01] active:scale-[0.99] cursor-pointer"
            >
              {t.modal.submit}
              <svg
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </button>

            <p class="text-[11px] text-faint text-center mt-3 tracking-wide">
              {t.modal.privacy}
            </p>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<style>
  /* Modal visibility and transitions */
  #contact-modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  #contact-modal-backdrop.open #contact-modal-dialog {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
</style>

<script>
  function initContactModal() {
    const backdrop = document.getElementById('contact-modal-backdrop');
    const dialog = document.getElementById('contact-modal-dialog');
    const closeBtn = document.getElementById('contact-modal-close');
    const form = document.getElementById('contact-modal-form') as HTMLFormElement | null;
    const successScreen = document.getElementById('modal-success-screen');
    const successIcon = document.getElementById('modal-success-icon');

    if (!backdrop || !dialog || !closeBtn) return;

    // Open Modal function
    function openModal() {
      // Check if modal has already been shown in this session
      try {
        if (sessionStorage.getItem('tc-modal-shown') === '1') {
          return;
        }
      } catch (e) {}

      backdrop?.classList.add('open');
      document.documentElement.classList.add('lenis-stopped');

      // Set session marker so it doesn't open again
      try {
        sessionStorage.setItem('tc-modal-shown', '1');
      } catch (e) {}
    }

    // Close Modal function
    function closeModal() {
      backdrop?.classList.remove('open');
      document.documentElement.classList.remove('lenis-stopped');
    }

    // Bind event listeners
    closeBtn.addEventListener('click', closeModal);
    
    // Close on backdrop click (click outside dialog)
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeModal();
      }
    });

    // Close on Escape key
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && backdrop.classList.contains('open')) {
        closeModal();
      }
    };
    window.addEventListener('keydown', handleKeyDown);

    // Form submission inside modal
    let successTimer: number | undefined;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        // Show success overlay
        if (successScreen && successIcon) {
          successScreen.classList.remove('opacity-0', 'pointer-events-none');
          successScreen.classList.add('opacity-100', 'pointer-events-auto');
          
          setTimeout(() => {
            successIcon.classList.remove('scale-90');
            successIcon.classList.add('scale-100');
          }, 50);

          form.reset();

          // Auto close modal after 6 seconds
          window.clearTimeout(successTimer);
          successTimer = window.setTimeout(() => {
            closeModal();
            // Reset success screen for next time (in case modal is reopened manually)
            setTimeout(() => {
              successScreen.classList.remove('opacity-100', 'pointer-events-auto');
              successScreen.classList.add('opacity-0', 'pointer-events-none');
              successIcon.classList.remove('scale-100');
              successIcon.classList.add('scale-90');
            }, 600);
          }, 6000);
        }
      });
    }

    // Trigger timer: 15 seconds after page loads
    const timerId = setTimeout(() => {
      openModal();
    }, 15000);

    return () => {
      clearTimeout(timerId);
      window.removeEventListener('keydown', handleKeyDown);
      if (successTimer) window.clearTimeout(successTimer);
    };
  }

  let cleanupModal: (() => void) | undefined;

  function setup() {
    if (cleanupModal) cleanupModal();
    cleanupModal = initContactModal();
  }

  // Initial load
  setup();
  
  // Astro view transitions swap event
  document.addEventListener('astro:after-swap', setup);
</script>
