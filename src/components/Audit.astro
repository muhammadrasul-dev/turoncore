---
import type { Translations } from '../i18n/ui';
import GeometricBg from './GeometricBg.astro';
import Button from './ui/Button.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

// List of audit features with their respective SVG icons
const auditFeatures = [
  {
    title: t.audit.features[0].title,
    desc: t.audit.features[0].desc,
    // Lightning bolt icon
    path: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  },
  {
    title: t.audit.features[1].title,
    desc: t.audit.features[1].desc,
    // Smartphone icon
    path: 'M12 18h.01M8 21h8a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2z',
  },
  {
    title: t.audit.features[2].title,
    desc: t.audit.features[2].desc,
    // Search icon
    path: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  },
  {
    title: t.audit.features[3].title,
    desc: t.audit.features[3].desc,
    // Layout icon
    path: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5z M4 10h16 M10 10v10',
  },
  {
    title: t.audit.features[4].title,
    desc: t.audit.features[4].desc,
    // Shield icon
    path: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  },
];
---

<section id="audit" class="section relative overflow-hidden">
  <GeometricBg grid={true} intensity="soft" />

  <div class="shell relative z-10">
    <div class="surface reveal overflow-hidden p-7 md:p-12 lg:p-16">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <span class="eyebrow">{t.audit.eyebrow}</span>
          <h2 class="headline mt-5 text-ink">{t.audit.title}</h2>
          <p class="lede mt-5 max-w-2xl">{t.audit.subtitle}</p>

          <div class="mt-10 space-y-6">
            {
              auditFeatures.map((feature, i) => (
                <div class="flex gap-4 items-start reveal" style={`--rd:${i * 80}ms`}>
                  <span class="tile h-10 w-10 shrink-0 border border-accent/10 bg-accent-soft text-accent">
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={feature.path} />
                    </svg>
                  </span>
                  <div>
                    <h3 class="font-bold text-ink text-base">{feature.title}</h3>
                    <p class="mt-1 text-sm text-muted leading-relaxed max-w-xl">{feature.desc}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col justify-center">
          <div class="rounded-2xl border border-hairline/30 bg-bg-soft/50 p-6 md:p-8 backdrop-blur-md">
            <form id="audit-form" class="flex flex-col gap-4" novalidate>
              <div>
                <label for="audit-website" class="mb-2 block text-sm font-medium text-muted">
                  {t.audit.form.website}
                </label>
                <input
                  type="text"
                  id="audit-website"
                  name="website"
                  required
                  placeholder={t.audit.form.websitePlaceholder}
                  class="field"
                />
              </div>

              <div>
                <label for="audit-phone" class="mb-2 block text-sm font-medium text-muted">
                  {t.audit.form.phone}
                </label>
                <input
                  type="tel"
                  id="audit-phone"
                  name="phone"
                  required
                  placeholder={t.audit.form.phonePlaceholder}
                  class="field"
                />
              </div>

              <div class="mt-4 flex flex-col gap-4">
                <Button type="submit" variant="primary" size="md" class="w-full justify-center">
                  {t.audit.form.submit}
                  <svg
                    class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h13M13 6l6 6-6 6"></path>
                  </svg>
                </Button>

                <p
                  id="audit-success"
                  class="text-sm font-medium text-accent opacity-0 transition-opacity duration-500 text-center"
                  role="status"
                >
                  {t.audit.form.success}
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

