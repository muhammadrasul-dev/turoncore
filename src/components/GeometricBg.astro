---
interface Props {
  class?: string;
  /** kept for existing callers; the Cupertino backdrop has no grid */
  grid?: boolean;
  intensity?: 'soft' | 'normal';
}

const { class: className = '', intensity = 'normal' } = Astro.props;
const soft = intensity === 'soft';
---

<div class:list={['mesh', className]} aria-hidden="true" style={soft ? 'opacity:0.6' : undefined}>
  <span class="blob blob-green" style="width:46rem;aspect-ratio:1;top:-22rem;right:-14rem"></span>
  <span class="blob blob-mint" style="width:34rem;aspect-ratio:1;bottom:-18rem;left:-12rem"></span>
  <span class="blob blob-lime" style="width:22rem;aspect-ratio:1;top:30%;right:10%;opacity:0.6"></span>
</div>
