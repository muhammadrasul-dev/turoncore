---
interface Props {
  title: string;
  highlight: string;
  index?: number;
}

const palettes = [
  'linear-gradient(135deg, #0d9b70 0%, #0b3b52 100%)',
  'linear-gradient(135deg, #5b47c9 0%, #131a3a 100%)',
  'linear-gradient(135deg, #c9663f 0%, #2a1630 100%)',
  'linear-gradient(135deg, #1f7fd4 0%, #0b2340 100%)',
  'linear-gradient(135deg, #c9a227 0%, #2a1f0b 100%)',
  'linear-gradient(135deg, #b03a5b 0%, #2a1020 100%)',
  'linear-gradient(135deg, #2a9d8f 0%, #1a3650 100%)',
];

const { title, highlight, index = 0 } = Astro.props;
---

<div
  class="relative flex aspect-[16/10] items-center justify-center overflow-hidden rounded-[calc(var(--r-lg)-0.55rem)]"
  style={`background:${palettes[index % palettes.length]}`}
  role="img"
  aria-label={`${title} — ${highlight}`}
>
  <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
  <div class="z-10 px-6 text-center">
    <span class="block font-display text-[2rem] font-bold leading-none tracking-tight text-white/90 md:text-[2.4rem]">
      {title}
    </span>
    <span class="mt-2 block max-w-[16rem] text-[0.75rem] font-medium tracking-wide text-white/80">
      {highlight}
    </span>
  </div>
</div>
