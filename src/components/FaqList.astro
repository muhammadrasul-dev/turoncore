---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="mt-12 divide-y divide-hairline/30">
      {items.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between font-display text-base font-bold text-ink hover:text-accent [&::-webkit-details-marker]:hidden">
            <span class="pr-6">{item.q}</span>
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">+</span>
          </summary>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  )
}
