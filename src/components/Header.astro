---
import type { Lang, Translations } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;

const navItems = [
  { href: '#services', label: t.nav.services },
  { href: '#about', label: t.nav.about },
  { href: '#process', label: t.nav.process },
  { href: '#portfolio', label: t.nav.portfolio },
  { href: '#tech', label: t.nav.tech },
  { href: '#contact', label: t.nav.contact },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 [&.scrolled]:glass [&.scrolled]:shadow-lg [&.scrolled]:shadow-emerald/5"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 md:px-6">
    <a
      href={`/${lang}/`}
      class="flex items-center gap-2 shrink-0 group transition-all duration-300 hover:scale-105"
    >
      <img
        id="logo-light"
        src="/logos/logo-navy.png"
        alt="TuronCore"
        class="h-8 md:h-9 w-auto transition-all duration-300 group-hover:drop-shadow-[0_0_8px_rgba(16,185,129,0.3)]"
        width="140"
        height="36"
      />
      <img
        id="logo-dark"
        src="/logos/logo-white.png"
        alt="TuronCore"
        class="h-8 md:h-9 w-auto hidden transition-all duration-300 group-hover:drop-shadow-[0_0_8px_rgba(16,185,129,0.3)]"
        width="140"
        height="36"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-8">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="relative text-sm font-medium text-navy/70 dark:text-white/70 hover:text-emerald transition-colors duration-200 group"
          >
            {item.label}
            <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-emerald group-hover:w-full transition-all duration-300" />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <LangSwitcher lang={lang} />
      <ThemeToggle />

      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden flex h-9 w-9 items-center justify-center rounded-lg glass hover:glow-emerald transition-all duration-300"
        aria-label="Toggle menu"
      >
        <svg
          id="menu-icon-open"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          id="menu-icon-close"
          class="h-5 w-5 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="lg:hidden hidden border-t border-navy/10 dark:border-white/10 glass shadow-xl"
  >
    <div class="flex flex-col px-4 py-4 gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="px-4 py-3 rounded-lg text-sm font-medium text-navy/70 dark:text-white/70 hover:bg-emerald/10 hover:text-emerald transition-all duration-200"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
