---
import type { Lang, Translations } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './ui/Logo.astro';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;

const navItems = [
  { href: '#services', label: t.nav.services },
  { href: '#sectors', label: t.nav.sectors },
  { href: '#about', label: t.nav.about },
  { href: '#process', label: t.nav.process },
  { href: '#portfolio', label: t.nav.portfolio },
  { href: '#tech', label: t.nav.tech },
  { href: '#audit', label: t.nav.audit },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 pt-3 md:pt-5 transition-all duration-500">
  <div class="shell">
    <div
      id="header-bar"
      class="relative flex items-center justify-between gap-4 rounded-full px-4 py-2.5 md:px-5 md:py-3 transition-all duration-500"
    >
      <a href={`/${lang}/`} class="group flex shrink-0 items-center" aria-label="TuronCore">
        <Logo class="transition-transform duration-500 group-hover:scale-[1.03]" />
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-navlink={item.href}
              class="relative rounded-full px-4 py-2 text-sm font-medium text-muted transition-colors duration-300 hover:text-ink"
            >
              <span class="relative z-10">{item.label}</span>
              <span
                aria-hidden="true"
                class="nav-pill pointer-events-none absolute inset-0 rounded-full bg-inset opacity-0 transition-opacity duration-300"
              />
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <LangSwitcher lang={lang} />
        <ThemeToggle />

        <a
          href="#contact"
          class="btn btn-primary hidden px-5 py-2.5 text-sm md:inline-flex"
        >
          {t.nav.contact}
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-inset text-ink transition-colors duration-300 lg:hidden"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="relative block h-3.5 w-4">
            <span
              id="bar-top"
              class="absolute left-0 top-0 h-[1.5px] w-full rounded-full bg-current transition-all duration-300"
            ></span>
            <span
              id="bar-mid"
              class="absolute left-0 top-1/2 h-[1.5px] w-full -translate-y-1/2 rounded-full bg-current transition-all duration-300"
            ></span>
            <span
              id="bar-bot"
              class="absolute bottom-0 left-0 h-[1.5px] w-full rounded-full bg-current transition-all duration-300"
            ></span>
          </span>
        </button>
      </div>
    </div>

    <nav
      id="mobile-menu"
      class="surface mt-2 grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-500 lg:hidden"
      style="--rd:0ms"
      aria-label="Mobile"
    >
      <div class="min-h-0">
        <div class="flex flex-col gap-1 p-3">
          {
            [...navItems, { href: '#contact', label: t.nav.contact }].map((item) => (
              <a
                href={item.href}
                class="rounded-2xl px-4 py-3 text-[0.95rem] font-medium text-muted transition-colors duration-300 hover:bg-accent-soft hover:text-accent"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #header-bar {
    box-shadow: none;
    background: transparent;
    backdrop-filter: none;
  }

  :global(#site-header.scrolled) #header-bar {
    background: var(--c-surface);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow:
      inset 0 1px 0 var(--sheen),
      var(--shadow-sm);
  }

  :global(a[data-navlink].active) {
    color: var(--c-text);
  }

  :global(a[data-navlink].active) .nav-pill {
    opacity: 1;
  }

  #mobile-menu:not(.open) {
    opacity: 0;
    background: transparent;
    box-shadow: none;
    pointer-events: none;
  }

  #mobile-menu {
    transition:
      grid-template-rows 0.5s var(--ease),
      opacity 0.35s var(--ease);
  }

  :global(#mobile-menu.open) {
    grid-template-rows: 1fr;
  }
</style>
