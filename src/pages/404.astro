---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getTranslations } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<BaseLayout lang={lang} t={t} title={t.pages.notFoundTitle} description={t.pages.notFoundText} robots="noindex, follow">
  <section class="section pt-36">
    <div class="shell max-w-xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="headline mt-5 text-ink">{t.pages.notFoundTitle}</h1>
      <p class="lede mt-5 text-muted">{t.pages.notFoundText}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={getLocalizedPath('/', lang)} class="btn btn-primary px-5 py-2.5 text-sm">{t.common.backHome}</a>
        <a href={getLocalizedPath('/services', lang)} class="btn btn-soft px-5 py-2.5 text-sm">{t.nav.services}</a>
        <a href={getLocalizedPath('/contact', lang)} class="btn btn-soft px-5 py-2.5 text-sm">{t.nav.contact}</a>
      </div>
    </div>
  </section>
</BaseLayout>
