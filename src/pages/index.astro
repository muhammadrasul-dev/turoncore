<!doctype html>
<html lang="uz">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TuronCore — Mobil ilova va Web saytlar</title>
    <meta name="description" content="TuronCore — mobil ilovalar, web saytlar va B2B IT xizmatlari." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Seamless redirection script that defaults to Uzbek -->
    <script is:inline>
      window.location.replace('/uz/');
    </script>

    <!-- Fallback redirect meta for non-JS or search indexers -->
    <noscript>
      <meta http-equiv="refresh" content="0;url=/uz/" />
    </noscript>

    <style>
      :root {
        --c-bg: #05070b;
        --c-accent: #3b82f6;
        --c-accent-bright: #60a5fa;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: var(--c-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        overflow: hidden;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      .intro-container {
        position: relative;
        display: flex;
        flex-col: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      /* Premium soft glow behind the logo */
      .glow-effect {
        position: absolute;
        width: 150px;
        height: 150px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.2) 0%, transparent 70%);
        filter: blur(25px);
        pointer-events: none;
        animation: pulse-glow 2s infinite ease-in-out;
      }

      .logo-wrapper {
        position: relative;
        z-index: 10;
        animation: scale-up-logo 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .brand-logo {
        width: 72px;
        height: 72px;
        color: #ffffff;
      }

      .brand-text {
        margin-top: 24px;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        opacity: 0;
        transform: translateY(12px);
        animation: fade-in-text 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
      }

      .brand-text span {
        font-weight: 300;
        color: #94a3b8;
      }

      /* Loading indicator */
      .loader-dots {
        margin-top: 16px;
        display: flex;
        gap: 6px;
        justify-content: center;
        opacity: 0;
        animation: fade-in-text 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
      }

      .dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background-color: var(--c-accent);
        animation: dot-pulse 1.4s infinite ease-in-out both;
      }

      .dot:nth-child(2) {
        animation-delay: 0.2s;
      }
      .dot:nth-child(3) {
        animation-delay: 0.4s;
      }

      @keyframes scale-up-logo {
        0% {
          opacity: 0;
          transform: scale(0.85);
        }
        100% {
          opacity: 1;
          transform: scale(1);
        }
      }

      @keyframes fade-in-text {
        0% {
          opacity: 0;
          transform: translateY(12px);
        }
        100% {
          opacity: 0.85;
          transform: translateY(0);
        }
      }

      @keyframes pulse-glow {
        0%, 100% {
          transform: scale(1);
          opacity: 0.8;
        }
        50% {
          transform: scale(1.15);
          opacity: 1;
        }
      }

      @keyframes dot-pulse {
        0%, 80%, 100% {
          transform: scale(0.6);
          opacity: 0.4;
        }
        40% {
          transform: scale(1.2);
          opacity: 1;
          background-color: var(--c-accent-bright);
        }
      }
    </style>
  </head>
  <body>
    <div class="intro-container">
      <div class="glow-effect"></div>
      
      <div class="logo-wrapper">
        <svg
          class="brand-logo"
          viewBox="0 0 48 48"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <g stroke="currentColor" stroke-width="2.6" stroke-linejoin="round">
            <rect x="10" y="10" width="28" height="28" rx="1.5"></rect>
            <rect x="10" y="10" width="28" height="28" rx="1.5" transform="rotate(45 24 24)"></rect>
          </g>
          <polygon
            points="32,24 28,30.9 20,30.9 16,24 20,17.1 28,17.1"
            fill="var(--c-accent)"
          ></polygon>
        </svg>
      </div>

      <div class="brand-text">Turon<span>Core</span></div>
      
      <div class="loader-dots">
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
      </div>
    </div>
  </body>
</html>
